+package am.ik.sluice.server.filter;
+
+import java.nio.ByteBuffer;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Sees one relayed exchange (spike): the payload of its bodies, decoded of the chunked
+ * framing, and its final response head, which it may edit. It sees interim heads and
+ * neither an upgraded connection's nor a CONNECT's bytes.
+ * <p>
+ * Every call runs on the relay's path and must not block: on h2 with the lock of the
+ * whole connection, on HTTP/1.1 with the lock of the client stream. The request and the
+ * response sides may run on two threads at once. A buffer is valid during its call only.
+ */
+public interface ExchangeObserver {
+
+	/** How an exchange ended. */
+	enum Outcome {
+
+		/** The request and the response both went through to their ends. */
+		COMPLETE,
+
+		/** The response was cut, or lost before any of it. */
+		INCOMPLETE
+
+	}
+
+	/** The headers of a response head. */
+	@FunctionalInterface
+	interface ResponseHeaders {
+
+		/**
+		 * Every value of the header, in order; empty when absent.
+		 * @param name the header name in lowercase
+		 */
+		List<String> values(String name);
+
+	}
+
+	/** What to change in a response head; the framing headers cannot be changed. */
+	record ResponseEdit(Set<String> strip, Map<String, String> add) {
+
+		public static final ResponseEdit NONE = new ResponseEdit(Set.of(), Map.of());
+
+	}
+
+	default void requestBody(ByteBuffer payload) {
+	}
+
+	default ResponseEdit responseHead(int status, ResponseHeaders headers) {
+		return ResponseEdit.NONE;
+	}
+
+	default void responseBody(ByteBuffer payload) {
+	}
+
+	/** Called once, last, for an exchange that was relayed. */
+	default void completed(Outcome outcome) {
+	}
+
+}
