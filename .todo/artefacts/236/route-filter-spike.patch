+package am.ik.sluice.server.filter;
+
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+
+import org.jspecify.annotations.Nullable;
+
+import am.ik.sluice.server.auth.RequestHeaders;
+import am.ik.sluice.server.route.Router;
+
+/**
+ * A per-route step over the requests the data plane reads (spike). It runs after the
+ * route's credential check, on the head with the credentials hidden, for every HTTP/1.1
+ * request head and h2 stream alike.
+ * <p>
+ * {@link #onRequest} must not block: on h2 it runs with the lock of the whole connection.
+ * What takes time goes in the returned future, which holds its own stream only.
+ */
+public interface RouteFilter {
+
+	boolean appliesTo(Router.Route route);
+
+	CompletableFuture<Decision> onRequest(Router.Route route, RequestHeaders request);
+
+	/** What a filter made of a request head. */
+	sealed interface Decision {
+
+		/**
+		 * The request goes on.
+		 *
+		 * @param strip the lowercase names of the headers removed
+		 * @param add the lowercase names and values of the headers added
+		 * @param observer told about the exchange once it is relayed; dropped unnoticed
+		 * when the request is not relayed after all
+		 */
+		record Proceed(Set<String> strip, Map<String, String> add,
+				@Nullable ExchangeObserver observer) implements Decision {
+
+			public static final Proceed UNCHANGED = new Proceed(Set.of(), Map.of(), null);
+
+		}
+
+		/**
+		 * The request is answered here and never relayed.
+		 *
+		 * @param status the status code
+		 * @param reason the reason phrase, also the access log's
+		 * {@code reason=filter-...}
+		 * @param contentType the content type of the body
+		 * @param body the body
+		 */
+		record Answer(int status, String reason, String contentType, byte[] body) implements Decision {
+		}
+
+	}
+
+}
diff --git a/sluice-server/src/main/java/am/ik/sluice/server/filter/RouteFilterChain.java b/sluice-server/src/main/java/am/ik/sluice/server/filter/RouteFilterChain.java
new file mode 100644
index 0000000..e29fc5e
--- /dev/null
+++ b/sluice-server/src/main/java/am/ik/sluice/server/filter/RouteFilterChain.java
@@ -0,0 +1,310 @@
+package am.ik.sluice.server.filter;
+
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+
+import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import org.springframework.beans.factory.ObjectProvider;
+import org.springframework.stereotype.Component;
+
+import am.ik.sluice.server.auth.RequestHeaders;
+import am.ik.sluice.server.auth.Verdict;
+import am.ik.sluice.server.route.Router;
+
+/**
+ * Runs a route's {@link RouteFilter}s after its credential check (spike): the outcome is
+ * a {@link Verdict}, so the relays need no new path for what a filter decides. A filter
+ * failing or timing out answers the request ({@code 500} / {@code 504}): a request the
+ * filters did not pass is never relayed. An observer failing is dropped and logged, the
+ * exchange going on.
+ */
+@Component
+public class RouteFilterChain {
+
+	private static final Logger log = LoggerFactory.getLogger(RouteFilterChain.class);
+
+	private static final Duration TIMEOUT = Duration.ofSeconds(5);
+
+	/** What a filter must not change: the framing, and what routed the request. */
+	private static final Set<String> PROTECTED = Set.of("content-length", "transfer-encoding", "connection", "upgrade",
+			"keep-alive", "proxy-connection", "te", "trailer", "host");
+
+	private final List<RouteFilter> filters;
+
+	public RouteFilterChain(ObjectProvider<RouteFilter> filters) {
+		List<RouteFilter> found = new ArrayList<>(filters.orderedStream().toList());
+		if ("1".equals(System.getenv("SLUICE_SPIKE_FILTER_ALL"))) {
+			found.add(new Passing());
+		}
+		this.filters = List.copyOf(found);
+	}
+
+	/** Whether the route has a filter: its relays hold its response heads. */
+	public boolean appliesTo(Router.Route route) {
+		for (RouteFilter filter : this.filters) {
+			if (filter.appliesTo(route)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	/** The verdict on a head after the filters, for a relay on a thread of its own. */
+	public Verdict apply(Router.Route route, RequestHeaders request, Verdict verdict) {
+		if (!appliesTo(route)) {
+			return verdict;
+		}
+		return applyAsync(route, request, CompletableFuture.completedFuture(verdict)).join();
+	}
+
+	/** The verdict on a head after the filters; the check's own future without one. */
+	public CompletableFuture<Verdict> applyAsync(Router.Route route, RequestHeaders request,
+			CompletableFuture<Verdict> checked) {
+		if (!appliesTo(route)) {
+			return checked;
+		}
+		return checked.thenCompose(verdict -> {
+			if (!(verdict instanceof Verdict.Pass pass)) {
+				return CompletableFuture.completedFuture(verdict);
+			}
+			RequestHeaders visible = hiding(request, pass.strip());
+			CompletableFuture<Verdict> run = CompletableFuture.completedFuture(pass);
+			for (RouteFilter filter : this.filters) {
+				if (filter.appliesTo(route)) {
+					run = run.thenCompose(so -> so instanceof Verdict.Pass passed
+							? decide(filter, route, visible, passed) : CompletableFuture.completedFuture(so));
+				}
+			}
+			return run;
+		});
+	}
+
+	private static CompletableFuture<Verdict> decide(RouteFilter filter, Router.Route route, RequestHeaders request,
+			Verdict.Pass pass) {
+		CompletableFuture<RouteFilter.Decision> decided;
+		try {
+			decided = filter.onRequest(route, request);
+		}
+		catch (RuntimeException e) {
+			decided = CompletableFuture.failedFuture(e);
+		}
+		return decided.orTimeout(TIMEOUT.toMillis(), java.util.concurrent.TimeUnit.MILLISECONDS)
+			.<Verdict>thenApply(decision -> switch (decision) {
+				case RouteFilter.Decision.Answer answer ->
+					new Verdict.Answered(answer.status(), answer.reason(), answer.contentType(), answer.body());
+				case RouteFilter.Decision.Proceed proceed -> merged(pass, proceed);
+			})
+			.exceptionally(failure -> {
+				log.warn("a filter of route {} failed: {}", route.routeTag(), failure.toString());
+				boolean timedOut = failure instanceof java.util.concurrent.TimeoutException
+						|| failure.getCause() instanceof java.util.concurrent.TimeoutException;
+				return answered(timedOut ? 504 : 500, timedOut ? "Gateway Timeout" : "Internal Server Error");
+			});
+	}
+
+	private static Verdict answered(int status, String reason) {
+		return new Verdict.Answered(status, reason, "text/plain", (reason + "\n").getBytes(StandardCharsets.US_ASCII));
+	}
+
+	private static Verdict merged(Verdict.Pass pass, RouteFilter.Decision.Proceed proceed) {
+		validate(proceed.strip(), proceed.add());
+		Set<String> strip = new HashSet<>(pass.strip());
+		strip.addAll(proceed.strip());
+		Map<String, String> add = new LinkedHashMap<>(pass.add());
+		add.putAll(proceed.add());
+		ExchangeObserver observer = proceed.observer();
+		ExchangeObserver safe = observer == null ? null : new Safe(observer);
+		return new Verdict.Pass(strip, add, compose(pass.observer(), safe));
+	}
+
+	/**
+	 * A value going on the wire as is must not carry a line break, a name must be a
+	 * lowercase token: an edit must not be able to smuggle a header or change the framing
+	 * the relay follows.
+	 */
+	static void validate(Set<String> strip, Map<String, String> add) {
+		for (String name : strip) {
+			checkName(name);
+		}
+		add.forEach((name, value) -> {
+			checkName(name);
+			for (int i = 0; i < value.length(); i++) {
+				char c = value.charAt(i);
+				if (c < 0x20 && c != '\t' || c == 0x7f || c > 0xff) {
+					throw new IllegalArgumentException("invalid value of header " + name);
+				}
+			}
+		});
+	}
+
+	private static void checkName(String name) {
+		if (name.isEmpty() || PROTECTED.contains(name)) {
+			throw new IllegalArgumentException("header " + name + " cannot be changed by a filter");
+		}
+		for (int i = 0; i < name.length(); i++) {
+			char c = name.charAt(i);
+			boolean token = c >= 'a' && c <= 'z' || c >= '0' && c <= '9' || "!#$%&'*+-.^_`|~".indexOf(c) >= 0;
+			if (!token) {
+				throw new IllegalArgumentException("invalid header name " + name);
+			}
+		}
+	}
+
+	private static RequestHeaders hiding(RequestHeaders request, Set<String> hidden) {
+		return new RequestHeaders() {
+
+			@Override
+			public String method() {
+				return request.method();
+			}
+
+			@Override
+			public String target() {
+				return request.target();
+			}
+
+			@Override
+			public List<String> values(String name) {
+				return hidden.contains(name) ? List.of() : request.values(name);
+			}
+
+		};
+	}
+
+	private static @Nullable ExchangeObserver compose(@Nullable ExchangeObserver first,
+			@Nullable ExchangeObserver second) {
+		if (first == null || second == null) {
+			return first == null ? second : first;
+		}
+		return new ExchangeObserver() {
+
+			@Override
+			public void requestBody(ByteBuffer payload) {
+				first.requestBody(payload.duplicate());
+				second.requestBody(payload.duplicate());
+			}
+
+			@Override
+			public ResponseEdit responseHead(int status, ResponseHeaders headers) {
+				// the last filter of the request is the first of the response
+				ResponseEdit inner = second.responseHead(status, headers);
+				ResponseEdit outer = first.responseHead(status, headers);
+				Set<String> strip = new HashSet<>(inner.strip());
+				strip.addAll(outer.strip());
+				Map<String, String> add = new LinkedHashMap<>(inner.add());
+				add.putAll(outer.add());
+				return new ResponseEdit(strip, add);
+			}
+
+			@Override
+			public void responseBody(ByteBuffer payload) {
+				first.responseBody(payload.duplicate());
+				second.responseBody(payload.duplicate());
+			}
+
+			@Override
+			public void completed(Outcome outcome) {
+				second.completed(outcome);
+				first.completed(outcome);
+			}
+
+		};
+	}
+
+	/** Drops an observer that failed: its failure must not reach a relay's thread. */
+	private static final class Safe implements ExchangeObserver {
+
+		private final ExchangeObserver delegate;
+
+		private volatile boolean failed;
+
+		Safe(ExchangeObserver delegate) {
+			this.delegate = delegate;
+		}
+
+		private void failed(RuntimeException e) {
+			this.failed = true;
+			log.warn("an exchange observer failed; dropping it", e);
+		}
+
+		@Override
+		public void requestBody(ByteBuffer payload) {
+			if (!this.failed) {
+				try {
+					this.delegate.requestBody(payload);
+				}
+				catch (RuntimeException e) {
+					failed(e);
+				}
+			}
+		}
+
+		@Override
+		public ResponseEdit responseHead(int status, ResponseHeaders headers) {
+			if (!this.failed) {
+				try {
+					ResponseEdit edit = this.delegate.responseHead(status, headers);
+					validate(edit.strip(), edit.add());
+					return edit;
+				}
+				catch (RuntimeException e) {
+					failed(e);
+				}
+			}
+			return ResponseEdit.NONE;
+		}
+
+		@Override
+		public void responseBody(ByteBuffer payload) {
+			if (!this.failed) {
+				try {
+					this.delegate.responseBody(payload);
+				}
+				catch (RuntimeException e) {
+					failed(e);
+				}
+			}
+		}
+
+		@Override
+		public void completed(Outcome outcome) {
+			try {
+				this.delegate.completed(outcome);
+			}
+			catch (RuntimeException e) {
+				log.warn("an exchange observer failed", e);
+			}
+		}
+
+	}
+
+	/**
+	 * For running the relay suites through the filter path; holds every response head.
+	 */
+	private static final class Passing implements RouteFilter {
+
+		@Override
+		public boolean appliesTo(Router.Route route) {
+			return true;
+		}
+
+		@Override
+		public CompletableFuture<Decision> onRequest(Router.Route route, RequestHeaders request) {
+			return CompletableFuture.completedFuture(new Decision.Proceed(Set.of(), Map.of(), new ExchangeObserver() {
+			}));
+		}
+
+	}
+
+}
