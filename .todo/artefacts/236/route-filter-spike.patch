+package am.ik.sluice.it;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import io.netty.buffer.Unpooled;
+import io.netty.handler.codec.http2.DefaultHttp2HeadersDecoder;
+import io.netty.handler.codec.http2.Http2Headers;
+import io.micrometer.core.instrument.simple.SimpleMeterRegistry;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestInstance;
+import org.junit.jupiter.api.TestInstance.Lifecycle;
+
+import am.ik.sluice.client.config.SluiceClientProperties;
+import am.ik.sluice.client.config.Upstream;
+import am.ik.sluice.client.tunnel.TunnelClient;
+import am.ik.sluice.server.SluiceServerApplication;
+import am.ik.sluice.server.auth.RequestHeaders;
+import am.ik.sluice.server.filter.ExchangeObserver;
+import am.ik.sluice.server.filter.RouteFilter;
+import am.ik.sluice.server.route.Router;
+import am.ik.sluice.server.tunnel.SessionRegistry;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.context.annotation.Bean;
+import org.springframework.test.context.DynamicPropertyRegistry;
+import org.springframework.test.context.DynamicPropertySource;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Spike: a per-route filter on the data plane, through a real server and tunnel client,
+ * over HTTP/1.1 and h2: the request and response heads edited, the bodies observed
+ * decoded, the request answered, the relay's framing and its 502 kept, and an async
+ * decision holding its own h2 stream only.
+ */
+@SpringBootTest(classes = { SluiceServerApplication.class, RouteFilterE2ETest.Filters.class },
+		webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+@TestInstance(Lifecycle.PER_CLASS)
+@SuppressWarnings("NullAway")
+class RouteFilterE2ETest {
+
+	private static final Duration TIMEOUT = Duration.ofSeconds(10);
+
+	private static int grpcPort;
+
+	private static int dataPort;
+
+	@TestConfiguration(proxyBeanMethods = false)
+	static class Filters {
+
+		@Bean
+		RecordingFilter recordingFilter() {
+			return new RecordingFilter();
+		}
+
+	}
+
+	/** What a filter saw of one exchange. */
+	static final class Recorded {
+
+		final ByteArrayOutputStream requestBody = new ByteArrayOutputStream();
+
+		final ByteArrayOutputStream responseBody = new ByteArrayOutputStream();
+
+		final CompletableFuture<ExchangeObserver.Outcome> outcome = new CompletableFuture<>();
+
+		volatile int status = -1;
+
+		volatile List<String> upstreamPrivate = List.of();
+
+	}
+
+	/** Applies to the hosts under {@code filtered.test}; the path picks the behavior. */
+	static final class RecordingFilter implements RouteFilter {
+
+		final Map<String, Recorded> recorded = new ConcurrentHashMap<>();
+
+		final CompletableFuture<Decision> slow = new CompletableFuture<>();
+
+		final Map<String, List<String>> secretsSeen = new ConcurrentHashMap<>();
+
+		@Override
+		public boolean appliesTo(Router.Route route) {
+			return route.domain().endsWith("filtered.test");
+		}
+
+		@Override
+		public CompletableFuture<Decision> onRequest(Router.Route route, RequestHeaders request) {
+			String target = request.target();
+			this.secretsSeen.put(target, request.values("authorization"));
+			return switch (target) {
+				case "/blocked" -> CompletableFuture.completedFuture(new Decision.Answer(451,
+						"Unavailable For Legal Reasons", "text/plain", "blocked\n".getBytes(StandardCharsets.UTF_8)));
+				case "/boom" -> throw new IllegalStateException("the filter failed");
+				case "/inject" -> CompletableFuture
+					.completedFuture(new Decision.Proceed(Set.of(), Map.of("x-filtered", "a\r\nx-smuggled: b"), null));
+				case "/framing" ->
+					CompletableFuture.completedFuture(new Decision.Proceed(Set.of("content-length"), Map.of(), null));
+				case "/slow" -> this.slow.thenApply(ignored -> proceed(target));
+				default -> CompletableFuture.completedFuture(proceed(target));
+			};
+		}
+
+		private Decision proceed(String target) {
+			Recorded record = new Recorded();
+			this.recorded.put(target, record);
+			return new Decision.Proceed(Set.of("x-secret"), Map.of("x-filtered", "yes"), new ExchangeObserver() {
+
+				@Override
+				public void requestBody(ByteBuffer payload) {
+					write(record.requestBody, payload);
+				}
+
+				@Override
+				public ResponseEdit responseHead(int status, ResponseHeaders headers) {
+					record.status = status;
+					record.upstreamPrivate = headers.values("x-upstream-private");
+					return new ResponseEdit(Set.of("x-upstream-private"), Map.of("x-observed", String.valueOf(status)));
+				}
+
+				@Override
+				public void responseBody(ByteBuffer payload) {
+					write(record.responseBody, payload);
+				}
+
+				@Override
+				public void completed(Outcome outcome) {
+					record.outcome.complete(outcome);
+				}
+
+			});
+		}
+
+		private static void write(ByteArrayOutputStream out, ByteBuffer payload) {
+			synchronized (out) {
+				while (payload.hasRemaining()) {
+					out.write(payload.get());
+				}
+			}
+		}
+
+	}
+
+	/**
+	 * An HTTP/1.1 upstream by script: a response with its head split over two writes and
+	 * a chunked body, a connection closed unanswered ({@code /close}), or a connection
+	 * closed inside a response head ({@code /partial}). It tells in {@code x-saw} what it
+	 * got of the headers filters change, and in {@code x-body} the body it read.
+	 */
+	static final class ScriptedUpstream implements AutoCloseable {
+
+		final ServerSocket server = new ServerSocket();
+
+		final AtomicInteger requests = new AtomicInteger();
+
+		ScriptedUpstream() throws IOException {
+			this.server.bind(new InetSocketAddress("127.0.0.1", 0));
+			Thread.ofVirtual().start(() -> {
+				while (!this.server.isClosed()) {
+					try {
+						Socket socket = this.server.accept();
+						Thread.ofVirtual().start(() -> serve(socket));
+					}
+					catch (IOException e) {
+						return;
+					}
+				}
+			});
+		}
+
+		private void serve(Socket socket) {
+			try (socket) {
+				InputStream in = socket.getInputStream();
+				OutputStream out = socket.getOutputStream();
+				while (true) {
+					String head = readLine(in, "\r\n\r\n");
+					if (head == null) {
+						return;
+					}
+					this.requests.incrementAndGet();
+					String lower = head.toLowerCase();
+					String body;
+					if (lower.contains("transfer-encoding: chunked")) {
+						StringBuilder read = new StringBuilder();
+						while (true) {
+							int size = Integer.parseInt(readLine(in, "\r\n").trim(), 16);
+							read.append(new String(in.readNBytes(size), StandardCharsets.ISO_8859_1));
+							in.readNBytes(2);
+							if (size == 0) {
+								break;
+							}
+						}
+						body = read.toString();
+					}
+					else {
+						int at = lower.indexOf("content-length: ");
+						int length = at < 0 ? 0
+								: Integer.parseInt(lower.substring(at + 16, lower.indexOf('\r', at)).trim());
+						body = new String(in.readNBytes(length), StandardCharsets.ISO_8859_1);
+					}
+					if (head.startsWith("GET /close ")) {
+						return;
+					}
+					if (head.startsWith("GET /partial ")) {
+						out.write("HTTP/1.1 200 OK\r\nX-Par".getBytes(StandardCharsets.US_ASCII));
+						out.flush();
+						return;
+					}
+					String saw = (lower.contains("x-filtered: yes") ? "filtered" : "unfiltered")
+							+ (lower.contains("x-secret") ? "+secret" : "");
+					boolean close = lower.contains("connection: close");
+					write(out, "HTTP/1.1 200 OK\r\nX-Upstr");
+					Thread.sleep(20);
+					write(out,
+							"eam-Private: 1\r\nX-Saw: " + saw + "\r\nX-Body: " + body + "\r\n"
+									+ (close ? "Connection: close\r\n" : "")
+									+ "Transfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n");
+					Thread.sleep(20);
+					write(out, "6\r\n world\r\n0\r\n\r\n");
+					if (close) {
+						return;
+					}
+				}
+			}
+			catch (Exception e) {
+				// the connection ended
+			}
+		}
+
+		private static void write(OutputStream out, String text) throws IOException {
+			out.write(text.getBytes(StandardCharsets.ISO_8859_1));
+			out.flush();
+		}
+
+		private static String readLine(InputStream in, String terminator) throws IOException {
+			StringBuilder line = new StringBuilder();
+			int b;
+			while ((b = in.read()) >= 0) {
+				line.append((char) b);
+				if (line.toString().endsWith(terminator)) {
+					return line.toString();
+				}
+			}
+			return null;
+		}
+
+		@Override
+		public void close() throws IOException {
+			this.server.close();
+		}
+
+	}
+
+	private final RecordingFilter filter;
+
+	private final SessionRegistry sessions;
+
+	private final java.util.List<TunnelClient> clients = new java.util.concurrent.CopyOnWriteArrayList<>();
+
+	private ScriptedUpstream scripted;
+
+	private HeaderEchoUpstream echo;
+
+	RouteFilterE2ETest(@Autowired RecordingFilter filter, @Autowired SessionRegistry sessions) {
+		this.filter = filter;
+		this.sessions = sessions;
+	}
+
+	@DynamicPropertySource
+	static void properties(DynamicPropertyRegistry registry) {
+		grpcPort = TestPorts.freePort();
+		dataPort = TestPorts.freePort();
+		registry.add("spring.grpc.server.port", () -> String.valueOf(grpcPort));
+		registry.add("sluice.data-port", () -> String.valueOf(dataPort));
+		registry.add("sluice.token", () -> "it-token");
+		registry.add("server.port", () -> String.valueOf(TestPorts.freePort()));
+	}
+
+	@BeforeAll
+	void start() throws Exception {
+		this.scripted = new ScriptedUpstream();
+		this.echo = new HeaderEchoUpstream("x-filtered", "x-secret");
+		startClient("h1.filtered.test", this.scripted.server.getLocalPort());
+		startClient("plain.test", this.scripted.server.getLocalPort());
+		startClient("h2.filtered.test", this.echo.port());
+	}
+
+	private void startClient(String host, int port) {
+		int before = this.sessions.count();
+		TunnelClient client = TunnelClient.builder()
+			.properties(SluiceClientProperties.builder()
+				.serverUrl("grpc://127.0.0.1:" + grpcPort)
+				.upstream(Upstream.builder().host(host).target("http://127.0.0.1:" + port).build())
+				.token("it-token")
+				.build())
+			.taskExecutor(task -> Thread.ofVirtual().start(task))
+			.meterRegistry(new SimpleMeterRegistry())
+			.build();
+		client.start();
+		this.clients.add(client);
+		Awaitility.await().atMost(TIMEOUT).until(() -> this.sessions.count() > before);
+	}
+
+	@AfterAll
+	void stop() throws Exception {
+		this.clients.forEach(TunnelClient::stop);
+		this.scripted.close();
+		this.echo.close();
+	}
+
+	/** Writes the bytes and reads to the connection's end. */
+	private static String exchange(String requests) throws Exception {
+		try (Socket socket = new Socket("127.0.0.1", dataPort)) {
+			socket.setSoTimeout((int) TIMEOUT.toMillis());
+			socket.getOutputStream().write(requests.getBytes(StandardCharsets.ISO_8859_1));
+			socket.getOutputStream().flush();
+			return new String(socket.getInputStream().readAllBytes(), StandardCharsets.ISO_8859_1);
+		}
+	}
+
+	private static String post(String path, String body) {
+		return "POST " + path + " HTTP/1.1\r\nHost: h1.filtered.test\r\nX-Secret: s3cret\r\n"
+				+ "Authorization: Bearer spike\r\nContent-Length: " + body.length() + "\r\n\r\n" + body;
+	}
+
+	private static String get(String host, String path, boolean close) {
+		return "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\n" + (close ? "Connection: close\r\n" : "") + "\r\n";
+	}
+
+	@Test
+	void http1HeadsAreEditedAndBodiesObservedPerRequestOfAPipeline() throws Exception {
+		String chunked = "POST /chunked HTTP/1.1\r\nHost: h1.filtered.test\r\nTransfer-Encoding: chunked\r\n\r\n"
+				+ "3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n";
+		String response = exchange(post("/first", "one") + chunked + get("h1.filtered.test", "/last", true));
+
+		assertThat(response.split("HTTP/1.1 200 OK", -1)).hasSize(4);
+		assertThat(response).doesNotContain("X-Upstream-Private")
+			.contains("x-observed: 200")
+			.contains("X-Saw: filtered\r\n")
+			.doesNotContain("secret")
+			.contains("X-Body: one\r\n")
+			.contains("X-Body: abcde\r\n")
+			// the body stays chunked on the wire, and whole
+			.contains("5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n");
+
+		for (String path : List.of("/first", "/chunked", "/last")) {
+			Recorded record = this.filter.recorded.get(path);
+			assertThat(record.outcome.get(10, TimeUnit.SECONDS)).isEqualTo(ExchangeObserver.Outcome.COMPLETE);
+			assertThat(record.status).isEqualTo(200);
+			assertThat(record.upstreamPrivate).containsExactly("1");
+			assertThat(record.responseBody.toString(StandardCharsets.ISO_8859_1)).isEqualTo("hello world");
+		}
+		assertThat(this.filter.recorded.get("/first").requestBody.toString(StandardCharsets.ISO_8859_1))
+			.isEqualTo("one");
+		assertThat(this.filter.recorded.get("/chunked").requestBody.toString(StandardCharsets.ISO_8859_1))
+			.isEqualTo("abcde");
+		assertThat(this.filter.secretsSeen.get("/first")).containsExactly("Bearer spike");
+	}
+
+	@Test
+	void aRouteWithoutFiltersIsRelayedUntouched() throws Exception {
+		String response = exchange(
+				"GET /plain HTTP/1.1\r\nHost: plain.test\r\nX-Secret: s\r\nConnection: close\r\n\r\n");
+
+		assertThat(response).contains("X-Upstream-Private: 1")
+			.doesNotContain("x-observed")
+			.contains("X-Saw: unfiltered+secret");
+		assertThat(this.filter.recorded).doesNotContainKey("/plain");
+	}
+
+	@Test
+	void http1RequestsTheFiltersDoNotPassNeverReachTheUpstream() throws Exception {
+		int before = this.scripted.requests.get();
+
+		assertThat(exchange(get("h1.filtered.test", "/blocked", false))).startsWith("HTTP/1.1 451 ")
+			.endsWith("blocked\n");
+		assertThat(exchange(get("h1.filtered.test", "/boom", false))).startsWith("HTTP/1.1 500 ");
+		assertThat(exchange(get("h1.filtered.test", "/inject", false))).startsWith("HTTP/1.1 500 ")
+			.doesNotContain("smuggled");
+		assertThat(exchange(get("h1.filtered.test", "/framing", false))).startsWith("HTTP/1.1 500 ");
+
+		assertThat(this.scripted.requests.get()).isEqualTo(before);
+	}
+
+	@Test
+	void http1UpstreamEndsAreAnsweredAsWithoutFilters() throws Exception {
+		assertThat(exchange(get("h1.filtered.test", "/close", false))).startsWith("HTTP/1.1 502 ");
+		assertThat(this.filter.recorded.get("/close").outcome.get(10, TimeUnit.SECONDS))
+			.isEqualTo(ExchangeObserver.Outcome.INCOMPLETE);
+
+		// a head begun is relayed as far as it came, as an unfiltered route relays it
+		assertThat(exchange(get("plain.test", "/partial", false))).isEqualTo("HTTP/1.1 200 OK\r\nX-Par");
+		assertThat(exchange(get("h1.filtered.test", "/partial", false))).isEqualTo("HTTP/1.1 200 OK\r\nX-Par");
+		assertThat(this.filter.recorded.get("/partial").outcome.get(10, TimeUnit.SECONDS))
+			.isEqualTo(ExchangeObserver.Outcome.INCOMPLETE);
+	}
+
+	@Test
+	void h2HeadsAreEditedAndBodiesObserved() throws Exception {
+		try (H2TestClient client = H2TestClient.connect(dataPort, 1, 3)) {
+			client.headers(1, false, h2Head("POST", "/h2", "x-secret=s3cret"));
+			assertThat(client.data(1, 32 * 1024, true, TIMEOUT)).isTrue();
+			assertThat(client.awaitEnd(1, TIMEOUT)).isTrue();
+
+			DefaultHttp2HeadersDecoder decoder = new DefaultHttp2HeadersDecoder(true);
+			Http2Headers response = decoder.decodeHeaders(1, Unpooled.wrappedBuffer(client.firstHeaderBlock(1)));
+			assertThat(response.status().toString()).isEqualTo("200");
+			assertThat(response.get("x-observed").toString()).isEqualTo("200");
+			String body = TestH2.bodyOf(client.frames(1));
+			assertThat(body).contains("x-filtered=yes").doesNotContain("x-secret");
+
+			Recorded record = this.filter.recorded.get("/h2");
+			assertThat(record.outcome.get(10, TimeUnit.SECONDS)).isEqualTo(ExchangeObserver.Outcome.COMPLETE);
+			assertThat(record.requestBody.size()).isEqualTo(32 * 1024);
+			assertThat(record.responseBody.toString(StandardCharsets.UTF_8)).isEqualTo(body);
+
+			// answered on its own stream, the connection going on
+			client.headers(3, true, h2Head("GET", "/blocked"));
+			assertThat(client.awaitEnd(3, TIMEOUT)).isTrue();
+			assertThat(decoder.decodeHeaders(3, Unpooled.wrappedBuffer(client.firstHeaderBlock(3))).status().toString())
+				.isEqualTo("451");
+			assertThat(client.goAwayCode()).isEqualTo(-1);
+		}
+	}
+
+	@Test
+	void h2AnAsyncDecisionHoldsItsOwnStreamOnly() throws Exception {
+		try (H2TestClient client = H2TestClient.connect(dataPort, 1, 3)) {
+			client.headers(1, false, h2Head("POST", "/slow"));
+			// sent while the decision is pending, held in the relay's account
+			assertThat(client.data(1, 1000, true, TIMEOUT)).isTrue();
+
+			client.headers(3, true, h2Head("GET", "/not-slow"));
+			assertThat(client.awaitEnd(3, TIMEOUT)).isTrue();
+			assertThat(client.ended(1)).isFalse();
+
+			this.filter.slow.complete(RouteFilter.Decision.Proceed.UNCHANGED);
+			assertThat(client.awaitEnd(1, TIMEOUT)).isTrue();
+			assertThat(TestH2.bodyOf(client.frames(1))).contains("x-filtered=yes");
+			Recorded record = this.filter.recorded.get("/slow");
+			assertThat(record.outcome.get(10, TimeUnit.SECONDS)).isEqualTo(ExchangeObserver.Outcome.COMPLETE);
+			assertThat(record.requestBody.size()).isEqualTo(1000);
+		}
+	}
+
+	private static byte[] h2Head(String method, String path, String... more) {
+		List<String> fields = new java.util.ArrayList<>(
+				List.of(":method=" + method, ":scheme=http", ":path=" + path, ":authority=h2.filtered.test"));
+		fields.addAll(List.of(more));
+		return TestH2.headerBlock(fields.toArray(String[]::new));
+	}
+
+}
