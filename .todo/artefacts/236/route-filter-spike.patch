@@ -0,0 +1,140 @@
+// Spike: a route's filter as a guest. Forwards each request to one upstream
+// (wasi:http/client), its heads edited and both bodies streamed through a tap,
+// or answers it itself: what a gateway filter does, in the wicket's sandbox.
+//
+// Build (from `examples/`): FILTER_UPSTREAM=<host:port> cargo build --release -p filter
+wit_bindgen::generate!({
+    path: "../../wit",
+    inline: "
+        package sluice:filter;
+
+        world filter {
+            import wasi:http/client@0.3.0;
+            import wasi:http/types@0.3.0;
+            export wasi:http/handler@0.3.0;
+        }
+    ",
+    features: ["clocks-timezone"],
+    generate_all,
+});
+
+use std::cell::Cell;
+use std::rc::Rc;
+
+use exports::wasi::http::handler::Guest;
+use wasi::http::client;
+use wasi::http::types::{ErrorCode, Headers, Request, Response, Scheme};
+use wit_bindgen::{StreamReader, StreamResult, StreamWriter};
+
+const UPSTREAM: &str = match option_env!("FILTER_UPSTREAM") {
+    Some(upstream) => upstream,
+    None => "127.0.0.1:18099",
+};
+
+struct Component;
+
+impl Guest for Component {
+    async fn handle(request: Request) -> Result<Response, ErrorCode> {
+        let path = request.get_path_with_query().unwrap_or_else(|| "/".into());
+        if path.starts_with("/blocked") {
+            return answer(451, b"blocked\n".to_vec());
+        }
+        let method = request.get_method();
+        let headers = request.get_headers().clone();
+        let _ = headers.delete("x-secret");
+        let _ = headers.append("x-filtered", b"yes");
+        let (request_done, request_res) = wit_future::new(|| Ok(()));
+        let (body, trailers) = Request::consume_body(request, request_res);
+        let (request_body, request_bytes) = tapped(body);
+        let (outgoing, _transmit) = Request::new(headers, Some(request_body), trailers, None);
+        let _ = outgoing.set_method(&method);
+        let _ = outgoing.set_scheme(Some(&Scheme::Http));
+        let _ = outgoing.set_authority(Some(UPSTREAM));
+        let _ = outgoing.set_path_with_query(Some(&path));
+
+        let response = client::send(outgoing).await?;
+        drop(request_done);
+
+        let status = response.get_status_code();
+        let headers = response.get_headers().clone();
+        let _ = headers.delete("x-upstream-private");
+        let _ = headers.append("x-observed", status.to_string().as_bytes());
+        let (response_done, response_res) = wit_future::new(|| Ok(()));
+        let (body, trailers) = Response::consume_body(response, response_res);
+        let (response_body, response_bytes) = tapped(body);
+        let (filtered, _transmit) = Response::new(headers, Some(response_body), trailers);
+        let _ = filtered.set_status_code(status);
+        wit_bindgen::spawn_local(async move {
+            let _keep = response_done;
+            response_bytes.ended.wait().await;
+            eprintln!(
+                "filter: {path} -> {status} request={} response={}",
+                request_bytes.count.get(),
+                response_bytes.count.get()
+            );
+        });
+        Ok(filtered)
+    }
+}
+
+export!(Component);
+
+/// The bytes a tap passed, and its end.
+struct Tap {
+    count: Rc<Cell<u64>>,
+    ended: Ended,
+}
+
+struct Ended(Rc<Cell<Option<StreamReader<u8>>>>);
+
+impl Ended {
+    /// Waits for the tap's end: its signal stream closing.
+    async fn wait(&self) {
+        if let Some(mut signal) = self.0.take() {
+            let _ = signal.read(Vec::with_capacity(1)).await;
+        }
+    }
+}
+
+/// Streams `from` through a counting pump.
+fn tapped(mut from: StreamReader<u8>) -> (StreamReader<u8>, Tap) {
+    let (mut to, out) = wit_stream::new();
+    let (signal_tx, signal_rx): (StreamWriter<u8>, StreamReader<u8>) = wit_stream::new();
+    let count = Rc::new(Cell::new(0));
+    let counted = count.clone();
+    wit_bindgen::spawn_local(async move {
+        let _signal = signal_tx; // dropped at the end: the signal
+        let mut chunk = Vec::with_capacity(16 * 1024);
+        loop {
+            let (status, read) = from.read(chunk).await;
+            match status {
+                StreamResult::Complete(n) => {
+                    counted.set(counted.get() + n as u64);
+                    let rest = to.write_all(read).await;
+                    if !rest.is_empty() {
+                        break;
+                    }
+                    chunk = Vec::with_capacity(16 * 1024);
+                }
+                StreamResult::Dropped | StreamResult::Cancelled => break,
+            }
+        }
+    });
+    let ended = Ended(Rc::new(Cell::new(Some(signal_rx))));
+    (out, Tap { count, ended })
+}
+
+fn answer(status: u16, payload: Vec<u8>) -> Result<Response, ErrorCode> {
+    let headers = Headers::new();
+    let _ = headers.append("content-type", b"text/plain");
+    let (mut body_tx, body_rx) = wit_stream::new();
+    let (trailers_tx, trailers_rx) = wit_future::new(|| Ok(None));
+    let (response, _transmit) = Response::new(headers, Some(body_rx), trailers_rx);
+    let _ = response.set_status_code(status);
+    wit_bindgen::spawn_local(async move {
+        let _ = body_tx.write_all(payload).await;
+        drop(body_tx);
+        let _ = trailers_tx.write(Ok(None)).await;
+    });
+    Ok(response)
+}
