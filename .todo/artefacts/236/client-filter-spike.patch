+							this.head.writeTo(this.out);
+							this.head.reset();
+							this.mode = Mode.PASS;
+						}
+					}
+					case BODY -> {
+						int n = (int) Math.min(this.remaining, end - i);
+						body(bytes, i, n);
+						i += n;
+						this.remaining -= n;
+						if (this.remaining == 0) {
+							finishRewriting();
+							endObserving(true);
+							this.mode = Mode.HEAD;
+						}
+					}
+					case CHUNK_SIZE -> {
+						raw(bytes[i]);
+						this.line.write(bytes[i++]);
+						if (bytes[i - 1] == '\n') {
+							onChunkSize();
+						}
+						else if (this.line.size() > MAX_HEAD) {
