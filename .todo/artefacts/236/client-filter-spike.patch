+package am.ik.sluice.it;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+import io.micrometer.core.instrument.simple.SimpleMeterRegistry;
+import org.awaitility.Awaitility;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.TestInstance;
+import org.junit.jupiter.api.TestInstance.Lifecycle;
+
+import am.ik.sluice.client.config.SluiceClientProperties;
+import am.ik.sluice.client.config.Upstream;
+import am.ik.sluice.client.filter.WasmResponseFilter;
+import am.ik.sluice.client.tunnel.TunnelClient;
+import am.ik.sluice.server.SluiceServerApplication;
+import am.ik.sluice.server.tunnel.SessionRegistry;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.test.context.DynamicPropertyRegistry;
+import org.springframework.test.context.DynamicPropertySource;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+/**
+ * Spike: token usage counted by a guest on the tunnel client, through a real server: the
+ * responses reach the client byte for byte, a stream as the upstream sends it, and a
+ * client leaving a stream is counted as cut.
+ */
+@SpringBootTest(classes = SluiceServerApplication.class, webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
+@TestInstance(Lifecycle.PER_CLASS)
+@SuppressWarnings("NullAway")
+class WasmFilterE2ETest {
+
+	private static final Duration TIMEOUT = Duration.ofSeconds(20);
+
+	private static final Path GUEST = Path.of("../sluice-client/src/test/resources/wasm/llm_usage.wasm");
+
+	private static final String JSON = "{\"model\":\"m\",\"usage\":{\"input_tokens\":12,\"output_tokens\":34}}";
+
+	private static final String START = "event: message_start\ndata: {\"type\":\"message_start\",\"message\":{\"model\":\"m\",\"usage\":{\"input_tokens\":5,\"output_tokens\":1}}}\n\n";
+
+	private static final String END = "event: message_delta\ndata: {\"type\":\"message_delta\",\"usage\":{\"output_tokens\":9}}\n\nevent: message_stop\ndata: {\"type\":\"message_stop\"}\n\n";
+
+	private static int grpcPort;
+
+	private static int dataPort;
+
+	private final SessionRegistry sessions;
+
+	private final SimpleMeterRegistry meters = new SimpleMeterRegistry();
+
+	private final List<String> heads = new CopyOnWriteArrayList<>();
+
+	private final CountDownLatch streamGate = new CountDownLatch(1);
+
+	private ServerSocket upstream;
+
+	private TunnelClient client;
+
+	WasmFilterE2ETest(@Autowired SessionRegistry sessions) {
+		this.sessions = sessions;
+	}
+
+	@DynamicPropertySource
+	static void properties(DynamicPropertyRegistry registry) {
+		grpcPort = TestPorts.freePort();
+		dataPort = TestPorts.freePort();
+		registry.add("spring.grpc.server.port", () -> String.valueOf(grpcPort));
+		registry.add("sluice.data-port", () -> String.valueOf(dataPort));
+		registry.add("sluice.token", () -> "it-token");
+		registry.add("server.port", () -> String.valueOf(TestPorts.freePort()));
+	}
+
+	@BeforeAll
+	void start() throws Exception {
+		this.upstream = new ServerSocket();
+		this.upstream.bind(new InetSocketAddress("127.0.0.1", 0));
+		Thread.ofVirtual().start(this::accept);
+		int before = this.sessions.count();
+		this.client = TunnelClient.builder()
+			.properties(SluiceClientProperties.builder()
+				.serverUrl("grpc://127.0.0.1:" + grpcPort)
+				.upstream(Upstream.builder()
+					.host("llm.test")
+					.target("http://127.0.0.1:" + this.upstream.getLocalPort())
+					.forceHttp1(true)
+					.build())
+				.token("it-token")
+				.build())
+			.taskExecutor(task -> Thread.ofVirtual().start(task))
+			.meterRegistry(this.meters)
+			.responseFilter(new WasmResponseFilter(GUEST, WasmResponseFilter.Limits.defaults(),
+					Set.of("accept-encoding"), this.meters))
+			.build();
+		this.client.start();
+		Awaitility.await().atMost(TIMEOUT).until(() -> this.sessions.count() > before);
+	}
+
+	@AfterAll
+	void stop() throws Exception {
+		this.client.stop();
+		this.upstream.close();
+	}
+
+	private void accept() {
+		while (!this.upstream.isClosed()) {
+			try {
+				Socket socket = this.upstream.accept();
+				Thread.ofVirtual().start(() -> serve(socket));
+			}
+			catch (IOException e) {
+				return;
+			}
+		}
+	}
+
+	private void serve(Socket socket) {
+		try (socket) {
+			InputStream in = socket.getInputStream();
+			OutputStream out = socket.getOutputStream();
+			while (true) {
+				StringBuilder read = new StringBuilder();
+				int b;
+				while (read.indexOf("\r\n\r\n") < 0 && (b = in.read()) >= 0) {
+					read.append((char) b);
+				}
+				if (read.indexOf("\r\n\r\n") < 0) {
+					return;
+				}
+				String head = read.toString();
+				this.heads.add(head);
+				String query = head.split(" ")[1];
+				if (query.endsWith("?json")) {
+					write(out, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: " + JSON.length()
+							+ "\r\n\r\n" + JSON);
+				}
+				else {
+					write(out,
+							"HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\n\r\n"
+									+ chunk(START));
+					this.streamGate.await(TIMEOUT.toSeconds(), TimeUnit.SECONDS);
+					if (query.endsWith("?leave")) {
+						// keeps streaming until the server ends the connection
+						while (true) {
+							write(out, chunk("event: ping\ndata: {\"type\":\"ping\"}\n\n"));
+							Thread.sleep(20);
+						}
+					}
+					write(out, chunk(END) + "0\r\n\r\n");
+				}
+				if (head.toLowerCase(Locale.ROOT).contains("connection: close")) {
+					return;
+				}
+			}
+		}
+		catch (Exception e) {
+			// the connection ended
+		}
+	}
+
+	private static String chunk(String text) {
+		return Integer.toHexString(text.length()) + "\r\n" + text + "\r\n";
+	}
+
+	private static void write(OutputStream out, String text) throws IOException {
+		out.write(text.getBytes(StandardCharsets.ISO_8859_1));
+		out.flush();
+	}
+
+	private static String request(String query, boolean close) {
+		return "POST /v1/messages" + query
+				+ " HTTP/1.1\r\nHost: llm.test\r\nAccept-Encoding: gzip\r\nContent-Length: 0\r\n"
+				+ (close ? "Connection: close\r\n" : "") + "\r\n";
+	}
+
+	private double tokens(String type) {
+		var counter = this.meters.find("sluice.client.filter.llm.tokens").tag("type", type).counter();
+		return counter == null ? 0 : counter.count();
+	}
+
+	private double requests(String outcome) {
+		return this.meters.find("sluice.client.filter.llm.requests")
+			.tag("outcome", outcome)
+			.counters()
+			.stream()
+			.mapToDouble(c -> c.count())
+			.sum();
+	}
+
+	@Test
+	void usageIsCountedAndTheResponsesPassUnchanged() throws Exception {
+		try (Socket socket = new Socket("127.0.0.1", dataPort)) {
+			socket.setSoTimeout((int) TIMEOUT.toMillis());
+			OutputStream out = socket.getOutputStream();
+			InputStream in = socket.getInputStream();
+			// a JSON body, then a stream on the same connection: each event as it is sent
+			write(out, request("?json", false));
+			StringBuilder read = new StringBuilder();
+			while (read.indexOf(JSON) < 0) {
+				read.append((char) in.read());
+			}
+			write(out, request("?stream", true));
+			while (read.indexOf(START) < 0) {
+				read.append((char) in.read());
+			}
+			assertThat(read.toString()).doesNotContain("message_delta");
+			this.streamGate.countDown();
+			String rest = new String(in.readAllBytes(), StandardCharsets.ISO_8859_1);
+			assertThat(rest).isEqualTo("\r\n" + chunk(END) + "0\r\n\r\n");
+		}
+		Awaitility.await().atMost(TIMEOUT).untilAsserted(() -> assertThat(requests("complete")).isEqualTo(2));
+		assertThat(tokens("input")).isEqualTo(12 + 5);
+		assertThat(tokens("output")).isEqualTo(34 + 9);
+		assertThat(this.heads).noneMatch(head -> head.toLowerCase(Locale.ROOT).contains("accept-encoding"));
+	}
+
+	@Test
+	void aClientLeavingAStreamIsCountedAsCut() throws Exception {
+		this.streamGate.countDown();
+		try (Socket socket = new Socket("127.0.0.1", dataPort)) {
+			socket.setSoTimeout((int) TIMEOUT.toMillis());
+			write(socket.getOutputStream(), request("?leave", false));
+			InputStream in = socket.getInputStream();
+			StringBuilder read = new StringBuilder();
+			while (read.indexOf("ping") < 0) {
+				read.append((char) in.read());
+			}
+		}
+		Awaitility.await().atMost(TIMEOUT).untilAsserted(() -> assertThat(requests("cut")).isEqualTo(1));
+	}
+
+}
