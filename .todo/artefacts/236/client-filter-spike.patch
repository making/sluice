+//! The usage filter on the ABI of this host.
+
+use sluice_filter::{Filter, Head, Mode, counter, filter};
+use usage_core::LlmUsage;
+
+#[derive(Default)]
+struct Guest(LlmUsage);
+
+impl Filter for Guest {
+    fn on_response(&mut self, head: &Head) -> Mode {
+        let (read, count) = self.0.on_response(
+            head.method,
+            head.target,
+            head.status,
+            head.header("content-type"),
+            head.header("content-encoding"),
+        );
+        if let Some(count) = count {
+            counter(count.name, &count.tags, count.value);
+        }
+        if read { Mode::Observe } else { Mode::Pass }
+    }
+
+    fn on_data(&mut self, data: &[u8]) {
+        self.0.on_data(data);
+    }
+
+    fn on_end(&mut self, complete: bool) {
+        for count in self.0.finish(complete) {
+            counter(count.name, &count.tags, count.value);
+        }
+    }
+}
+
+filter!(Guest);
