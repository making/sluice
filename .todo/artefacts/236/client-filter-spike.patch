new file mode 100644
index 0000000..443f98e
--- /dev/null
+++ b/sluice-client/src/test/guest/usage-core/src/lib.rs
@@ -0,0 +1,292 @@
+//! Token usage of the OpenAI compatible APIs and of the Anthropic API, read from their
+//! responses: one scanner, one dialect per API, the same counters out. No host in here.
+
+use serde_json::Value;
+
+/// A JSON body held to read its `usage`, and an SSE line.
+const LIMIT: usize = 4 * 1024 * 1024;
+
+#[derive(Clone, Copy, PartialEq)]
+enum Api {
+    Chat,
+    Responses,
+    Anthropic,
+}
+
+impl Api {
+    fn of(method: &str, path: &str) -> Option<Api> {
+        if method != "POST" {
+            return None;
+        }
+        match path.strip_suffix('/').unwrap_or(path) {
+            "/v1/chat/completions" | "/v1/completions" => Some(Api::Chat),
+            "/v1/responses" => Some(Api::Responses),
+            "/v1/messages" => Some(Api::Anthropic),
+            _ => None,
+        }
+    }
+
+    fn name(self) -> &'static str {
+        match self {
+            Api::Chat | Api::Responses => "openai",
+            Api::Anthropic => "anthropic",
+        }
+    }
+}
+
+/// `input` excludes what the cache served, as the Anthropic API reports it.
+#[derive(Default)]
+struct Tokens {
+    input: Option<u64>,
+    output: Option<u64>,
+    cache_read: Option<u64>,
+    cache_creation: Option<u64>,
+}
+
+impl Tokens {
+    fn any(&self) -> bool {
+        self.input.is_some() || self.output.is_some()
+    }
+
+    /// Later values overwrite, field by field: they are cumulative, never to be added.
+    fn update(&mut self, api: Api, usage: &Value) {
+        let n = |key: &str| usage.get(key).and_then(Value::as_u64);
+        match api {
+            Api::Anthropic => {
+                self.input = n("input_tokens").or(self.input);
+                self.output = n("output_tokens").or(self.output);
+                self.cache_read = n("cache_read_input_tokens").or(self.cache_read);
+                self.cache_creation = n("cache_creation_input_tokens").or(self.cache_creation);
+            }
+            Api::Chat | Api::Responses => {
+                let (input, output, details) = if api == Api::Chat {
+                    ("prompt_tokens", "completion_tokens", "prompt_tokens_details")
+                } else {
+                    ("input_tokens", "output_tokens", "input_tokens_details")
+                };
+                let detail = |key: &str| {
+                    usage.get(details).and_then(|d| d.get(key)).and_then(Value::as_u64).unwrap_or(0)
+                };
+                let (cached, written) = (detail("cached_tokens"), detail("cache_write_tokens"));
+                // their input is the total: what the cache served and took is within it
+                if let Some(total) = n(input) {
+                    self.input = Some(total.saturating_sub(cached).saturating_sub(written));
+                    self.cache_read = Some(cached);
+                    self.cache_creation = Some(written);
+                }
+                self.output = n(output).or(self.output);
+            }
+        }
+    }
+}
+
+#[derive(PartialEq)]
+enum Body {
+    Json,
+    Sse,
+}
+
+/// A counter to add to; `tags` are `key=value` lines.
+pub struct Count {
+    pub name: &'static str,
+    pub tags: String,
+    pub value: u64,
+}
+
+#[derive(Default)]
+pub struct LlmUsage {
+    api: Option<Api>,
+    body: Option<Body>,
+    held: Vec<u8>,
+    too_large: bool,
+    skipping_line: bool,
+    model: Option<String>,
+    tokens: Tokens,
+    terminal: bool,
+    error: bool,
+}
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+impl LlmUsage {
+    fn on_json_event(&mut self, api: Api, value: &Value) {
+        let kind = value.get("type").and_then(Value::as_str).unwrap_or("");
+        let (usage, model) = match (api, kind) {
+            (Api::Anthropic, "message_start") => {
+                let message = value.get("message");
+                (message.and_then(|m| m.get("usage")), message.and_then(|m| m.get("model")))
+            }
+            (Api::Responses, "response.created" | "response.completed" | "response.incomplete" | "response.failed") => {
+                let response = value.get("response");
+                (response.and_then(|r| r.get("usage")), response.and_then(|r| r.get("model")))
+            }
+            _ => (value.get("usage"), value.get("model")),
+        };
+        if let Some(usage) = usage.filter(|u| u.is_object()) {
+            self.tokens.update(api, usage);
+        }
+        if self.model.is_none() {
+            self.model = model.and_then(Value::as_str).map(str::to_owned);
+        }
+        match (api, kind) {
+            (Api::Anthropic, "message_stop") | (Api::Responses, "response.completed") => self.terminal = true,
+            (Api::Responses, "response.failed" | "response.incomplete") => {
+                self.terminal = true;
+                self.error = true;
+            }
+            (_, "error") => self.error = true,
+            _ => {}
+        }
+        if value.get("error").is_some_and(|e| !e.is_null()) {
+            self.error = true;
+        }
+    }
+
+    fn on_line(&mut self, api: Api, line: &[u8]) {
+        let line = line.strip_suffix(b"\r").unwrap_or(line);
+        let Some(data) = line.strip_prefix(b"data:") else {
+            return;
+        };
+        let data = data.strip_prefix(b" ").unwrap_or(data);
+        if data == b"[DONE]" {
+            self.terminal = true;
+            return;
+        }
+        // the token deltas carry nothing of interest: not worth parsing
+        let interesting = self.model.is_none()
+            || contains(data, b"\"usage\"")
+            || contains(data, b"\"error\"")
+            || contains(data, b"message_stop")
+            || contains(data, b"response.");
+        if !interesting {
+            return;
+        }
+        if let Ok(value) = serde_json::from_slice::<Value>(data) {
+            self.on_json_event(api, &value);
+        }
+    }
+
+    fn on_sse(&mut self, api: Api, mut data: &[u8]) {
+        while let Some(end) = data.iter().position(|b| *b == b'\n') {
+            let (part, rest) = data.split_at(end);
+            data = &rest[1..];
+            if self.skipping_line {
+                self.skipping_line = false;
+            } else if self.held.is_empty() {
+                self.on_line(api, part);
+            } else {
+                self.held.extend_from_slice(part);
+                let line = core::mem::take(&mut self.held);
+                self.on_line(api, &line);
+            }
+        }
+        if !self.skipping_line {
+            if self.held.len() + data.len() > LIMIT {
+                self.held = Vec::new();
+                self.skipping_line = true;
+                self.too_large = true;
+            } else {
+                self.held.extend_from_slice(data);
+            }
+        }
+    }
+}
+
+impl LlmUsage {
+    /// A final response head: whether its body is worth reading, and what to count now.
+    pub fn on_response(
+        &mut self,
+        method: &str,
+        path: &str,
+        status: u16,
+        content_type: Option<&str>,
+        content_encoding: Option<&str>,
+    ) -> (bool, Option<Count>) {
+        let Some(api) = Api::of(method, path.split('?').next().unwrap_or("")) else {
+            return (false, None);
+        };
+        let requests = |outcome: String| Count {
+            name: "llm.requests",
+            tags: format!("api={}\noutcome={outcome}", api.name()),
+            value: 1,
+        };
+        if !(200..300).contains(&status) {
+            return (false, Some(requests(format!("status_{}", status / 100))));
+        }
+        if content_encoding.is_some_and(|e| !e.eq_ignore_ascii_case("identity")) {
+            return (false, Some(requests("encoded".to_owned())));
+        }
+        let content_type = content_type.unwrap_or("").to_ascii_lowercase();
+        self.body = if content_type.starts_with("text/event-stream") {
+            Some(Body::Sse)
+        } else if content_type.starts_with("application/json") {
+            Some(Body::Json)
+        } else {
+            return (false, Some(requests("other_type".to_owned())));
+        };
+        self.api = Some(api);
+        (true, None)
+    }
+
+    pub fn on_data(&mut self, data: &[u8]) {
+        let Some(api) = self.api else { return };
+        if self.body == Some(Body::Sse) {
+            self.on_sse(api, data);
+        } else if self.held.len() + data.len() > LIMIT {
+            self.held = Vec::new();
+            self.too_large = true;
+        } else if !self.too_large {
+            self.held.extend_from_slice(data);
+        }
+    }
+
+    /// The end of the body, or of the connection before it (`complete` false).
+    pub fn finish(&mut self, complete: bool) -> Vec<Count> {
+        let Some(api) = self.api else { return Vec::new() };
+        if self.body == Some(Body::Json) && !self.too_large && complete {
+            let held = core::mem::take(&mut self.held);
+            if let Ok(value) = serde_json::from_slice::<Value>(&held) {
+                self.on_json_event(api, &value);
+                self.terminal = true;
+            }
+        }
+        let streamed = self.body == Some(Body::Sse);
+        let outcome = if self.error {
+            "error"
+        } else if !complete || (streamed && !self.terminal) {
+            "cut"
+        } else if self.too_large {
+            "too_large"
+        } else if !self.tokens.any() {
+            "no_usage"
+        } else {
+            "complete"
+        };
+        let model = self.model.as_deref().unwrap_or("unknown");
+        let name = api.name();
+        let mut counts = vec![Count {
+            name: "llm.requests",
+            tags: format!("api={name}\nmodel={model}\nstream={streamed}\noutcome={outcome}"),
+            value: 1,
+        }];
+        let kinds = [
+            ("input", self.tokens.input),
+            ("output", self.tokens.output),
+            ("cache_read", self.tokens.cache_read),
+            ("cache_creation", self.tokens.cache_creation),
+        ];
+        for (kind, value) in kinds {
+            if let Some(value) = value.filter(|v| *v > 0) {
+                counts.push(Count {
+                    name: "llm.tokens",
+                    tags: format!("api={name}\nmodel={model}\ntype={kind}"),
+                    value,
+                });
+            }
+        }
+        self.api = None;
+        counts
+    }
+}
