@@ -0,0 +1,143 @@
+package am.ik.sluice.client.filter;
+
+import java.io.ByteArrayOutputStream;
+import java.util.List;
+import java.util.Set;
+import java.util.function.UnaryOperator;
+
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Edits the responses of an upstream on the tunnel client (spike), for the connections
+ * the server speaks HTTP/1.1 on. Every call runs on the connection's own virtual thread:
+ * it may block, holding that connection's responses only, and the tunnel's flow control
+ * holds the upstream meanwhile.
+ */
+public interface ResponseFilter {
+
+	/** The request a response answers, as it reached the client. */
+	record Request(String address, String method, String target, String version, @Nullable String host) {
+	}
+
+	/** The fields of a head; the framing ones cannot be changed. */
+	interface Headers {
+
+		/** Every value of the header, in order; empty when absent. */
+		List<String> values(String name);
+
+		/** Replaces the header's values with this one, the name as given. */
+		void set(String name, String value);
+
+		void remove(String name);
+
+		/** The fields as lines, {@code name: value}, in order. */
+		List<String> lines();
+
+	}
+
+	/** What a filter does with a body: {@link BodyRewriter} or {@link BodyObserver}. */
+	sealed interface BodyHandler permits BodyRewriter, BodyObserver {
+
+	}
+
+	/**
+	 * Reads a body relayed as the upstream framed it; called on the payload, without the
+	 * chunked framing. Its failure leaves the response alone, and ends the observation.
+	 */
+	non-sealed interface BodyObserver extends BodyHandler {
+
+		void onData(byte[] bytes, int offset, int length);
+
+		/**
+		 * The end of the observation, called once.
+		 * @param complete false when the body was cut: the upstream or the client ended
+		 * the connection before its end
+		 */
+		void onEnd(boolean complete);
+
+		/** A call of this observer threw; nothing more is called. */
+		default void onFailure(RuntimeException failure) {
+		}
+
+	}
+
+	/**
+	 * Rewrites a body as it streams: what comes back goes to the client at once, chunked.
+	 * Called on the payload, without the upstream's chunked framing.
+	 */
+	non-sealed interface BodyRewriter extends BodyHandler {
+
+		byte[] onData(byte[] bytes, int offset, int length);
+
+		/** The end of the body; what comes back is its last part. */
+		byte[] onEnd();
+
+		/** The exchange is over, whether {@link #onEnd()} was called or not. */
+		default void onClose() {
+		}
+
+	}
+
+	/** One request, from its head on, until its response ended. */
+	interface Exchange {
+
+		/**
+		 * A final response head.
+		 * @param bodiless whether no body follows it
+		 * @return how to handle the body; null relays it as it is, unseen
+		 */
+		@Nullable BodyHandler onResponse(int status, Headers headers, boolean bodiless);
+
+		/** No response will be offered: the connection ended, or left HTTP. */
+		default void abandon() {
+		}
+
+	}
+
+	/**
+	 * A request head on its way to the upstream, on the thread relaying the request. Its
+	 * edits reach the upstream.
+	 */
+	default Exchange onRequest(Request request, Headers headers) {
+		return (status, responseHeaders, bodiless) -> onResponse(request, status, responseHeaders);
+	}
+
+	/** The request headers removed on the way to the upstream, lowercase. */
+	default Set<String> requestHeadersRemoved(String address) {
+		return Set.of();
+	}
+
+	/**
+	 * A final response head; 1xx heads and what follows a 101 pass unseen. Not called for
+	 * a request of HTTP/1.0, which cannot take the chunked framing a rewrite needs.
+	 * @return how to handle the body; null relays it as it is, unseen
+	 */
+	@Nullable BodyHandler onResponse(Request request, int status, Headers headers);
+
+	/**
+	 * A rewriter holding the whole body in memory, up to {@code limit} bytes, for a
+	 * transformation that needs all of it: past the limit the rewriter throws, and the
+	 * response is cut.
+	 */
+	static BodyRewriter whole(long limit, UnaryOperator<byte[]> transformation) {
+		ByteArrayOutputStream held = new ByteArrayOutputStream();
+		return new BodyRewriter() {
+
+			@Override
+			public byte[] onData(byte[] bytes, int offset, int length) {
+				if (held.size() + (long) length > limit) {
+					throw new IllegalStateException("a body past " + limit + " bytes");
+				}
+				held.write(bytes, offset, length);
+				return new byte[0];
+			}
+
+			@Override
+			public byte[] onEnd() {
+				return transformation.apply(held.toByteArray());
+			}
+
+		};
+	}
+
+}
