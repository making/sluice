+ * user can add one to the released native image, where bytecode cannot be generated. One
+ * instance serves one response, so a guest keeps nothing between responses. The guest is
+ * not trusted: it reaches nothing but the imports below, its memory and each call's time
+ * are bounded, and what it sends is validated.
+ *
+ * <p>
+ * A guest failing on a head fails open by default, the response relayed as if the filter
+ * were not there, or else the response fails ({@code failClosed}). A guest failing on an
+ * observed body stops observing it; on a rewritten body the response is cut.
+ */
+public final class WasmResponseFilter implements ResponseFilter {
+
+	private static final Logger log = LoggerFactory.getLogger(WasmResponseFilter.class);
+
+	private static final int ABI = 1;
+
+	private static final int MODE_PASS = 0;
+
+	private static final int MODE_OBSERVE = 1;
+
+	private static final int MODE_REWRITE = 2;
+
+	private static final int MAX_LOG = 1024;
+
+	private static final int MAX_LOGS_PER_RESPONSE = 16;
+
+	private static final int MAX_TAG_VALUE = 128;
+
+	private static final int MAX_NAME = 1024;
+
+	private static final Pattern METER_NAME = Pattern.compile("[a-z][a-z0-9_.]{0,63}");
+
+	private static final Pattern TAG_KEY = Pattern.compile("[a-z][a-z0-9_]{0,31}");
+
+	private static final FunctionType COUNTER = FunctionType
+		.of(List.of(ValType.I32, ValType.I32, ValType.I32, ValType.I32, ValType.I64), List.of());
+
+	private static final FunctionType BYTES = FunctionType.of(List.of(ValType.I32, ValType.I32), List.of());
+
+	private static final FunctionType BYTES_BYTES = FunctionType
+		.of(List.of(ValType.I32, ValType.I32, ValType.I32, ValType.I32), List.of());
+
+	/**
+	 * What bounds a guest.
+	 *
+	 * @param maxPages pages of 64KiB one instance may hold
+	 * @param callTimeout how long one call into the guest may run
+	 * @param maxWrite bytes one call may write of a rewritten body
+	 * @param maxMeters counters a guest may create; past it they are dropped and counted
+	 * @param failClosed whether a guest failing on a head fails the response
+	 */
+	public record Limits(int maxPages, Duration callTimeout, int maxWrite, int maxMeters, boolean failClosed) {
+
+		public static Limits defaults() {
+			return new Limits(256, Duration.ofSeconds(1), 16 * 1024 * 1024, 1024, false);
+		}
+
+	}
+
+	private final String name;
+
+	private final WasmModule module;
+
+	private final int initialPages;
+
+	private final Limits limits;
+
+	private final Set<String> requestHeadersRemoved;
+
+	private final MeterRegistry registry;
+
+	private final Map<String, Counter> meters = new ConcurrentHashMap<>();
+
+	private final Counter dropped;
+
+	public WasmResponseFilter(Path wasm, Limits limits, Set<String> requestHeadersRemoved, MeterRegistry registry) {
+		this.name = wasm.getFileName().toString().replaceFirst("\\.wasm$", "");
+		this.module = Parser.parse(wasm);
+		this.limits = limits;
+		this.requestHeadersRemoved = Set.copyOf(requestHeadersRemoved);
+		this.registry = registry;
+		this.dropped = Counter.builder("sluice.client.filter.guest.meters.dropped")
+			.tag("filter", this.name)
+			.register(registry);
+		this.initialPages = this.module.memorySection()
+			.filter(memories -> memories.memoryCount() == 1)
+			.map(memories -> memories.getMemory(0).limits().initialPages())
+			.orElseThrow(() -> new IllegalArgumentException(this.name + " must define one memory"));
+		if (this.initialPages > limits.maxPages()) {
+			throw new IllegalArgumentException(
+					this.name + " needs " + this.initialPages + " pages, past the limit of " + limits.maxPages());
+		}
+		// refused at the start, not on the first response
+		new Guest().check();
+	}
+
+	@Override
+	public Set<String> requestHeadersRemoved(String address) {
+		return this.requestHeadersRemoved;
+	}
+
+	@Override
+	public @Nullable BodyHandler onResponse(Request request, int status, Headers headers) {
+		try {
+			Guest guest = new Guest();
+			int mode = guest.onResponse(request, status, headers);
+			return switch (mode) {
+				case MODE_PASS -> null;
+				case MODE_OBSERVE -> guest.observer();
+				case MODE_REWRITE -> guest.rewriter();
+				default -> throw new GuestFailure("mode " + mode);
+			};
+		}
+		catch (GuestFailure e) {
+			failed("head", e);
+			if (this.limits.failClosed()) {
+				throw e;
+			}
+			return null;
+		}
+	}
+
+	private void failed(String phase, Exception e) {
+		log.warn("filter {} failed on a {}: {}", this.name, phase, e.getMessage());
+		Counter.builder("sluice.client.filter.guest.failures")
+			.tag("filter", this.name)
+			.tag("phase", phase)
+			.register(this.registry)
+			.increment();
+	}
+
+	private void count(String meter, String tags, long value) {
+		if (!METER_NAME.matcher(meter).matches() || value < 0) {
+			throw new GuestFailure("invalid counter " + meter + " of " + value);
+		}
+		String key = meter + '\n' + tags;
+		Counter counter = this.meters.get(key);
+		if (counter == null) {
+			// the tags may come from the upstream's responses: bounded here
+			if (this.meters.size() >= this.limits.maxMeters()) {
+				this.dropped.increment();
+				return;
+			}
+			counter = this.meters.computeIfAbsent(key,
+					k -> Counter.builder("sluice.client.filter." + meter)
+						.tags(tagsOf(tags))
+						.tag("filter", this.name)
+						.register(this.registry));
+		}
+		counter.increment(value);
+	}
+
+	private static Tags tagsOf(String text) {
+		Tags tags = Tags.empty();
+		for (String line : text.split("\n")) {
+			int equals = line.indexOf('=');
+			if (line.isEmpty()) {
+				continue;
+			}
+			String key = equals < 0 ? "" : line.substring(0, equals);
+			if (!TAG_KEY.matcher(key).matches() || key.equals("filter")) {
+				throw new GuestFailure("invalid tag " + key);
+			}
+			String value = line.substring(equals + 1);
+			tags = tags.and(key, value.length() > MAX_TAG_VALUE ? value.substring(0, MAX_TAG_VALUE) : value);
+		}
+		return tags;
+	}
+
+	private static String text(Instance instance, long pointer, long length) {
+		return new String(bytes(instance, pointer, length, MAX_NAME), StandardCharsets.UTF_8);
+	}
+
+	/** The guest's pointers are not trusted; the memory checks the range. */
+	private static byte[] bytes(Instance instance, long pointer, long length, int limit) {
+		int len = (int) length;
+		if (len < 0 || len > limit) {
+			throw new GuestFailure("a length of " + (length & 0xffffffffL) + " past " + limit);
+		}
+		return instance.memory().readBytes((int) pointer, len);
+	}
+
+	/** A guest did what it may not, trapped or ran out of its time. */
+	static final class GuestFailure extends RuntimeException {
+
+		GuestFailure(String message) {
+			super(message);
+		}
+
+		GuestFailure(String message, Throwable cause) {
+			super(message, cause);
+		}
+
+	}
+
+	/** Interrupts the calls past their time: the interpreter checks at each branch. */
+	static final class Watchdog {
+
+		/** As many guests compute at once as there are processors. */
+		static final ExecutorService POOL;
+
+		static {
+			ThreadPoolExecutor pool = new ThreadPoolExecutor(Runtime.getRuntime().availableProcessors(),
+					Runtime.getRuntime().availableProcessors(), 30, TimeUnit.SECONDS, new LinkedBlockingQueue<>(),
+					Thread.ofPlatform().daemon().name("sluice-wasm-guest-", 0).factory());
+			pool.allowCoreThreadTimeOut(true);
+			POOL = pool;
+		}
+
+		static final Set<Call> calls = ConcurrentHashMap.newKeySet();
+
+		static {
+			Thread.ofPlatform().daemon().name("sluice-wasm-watchdog").start(Watchdog::run);
+		}
+
+		private static void run() {
+			while (true) {
+				try {
+					Thread.sleep(20);
+				}
+				catch (InterruptedException e) {
+					return;
+				}
+				long now = System.nanoTime();
+				for (Call call : calls) {
+					if (now - call.deadline > 0) {
+						call.interrupt();
+					}
+				}
+			}
+		}
+
+		/** One call into a guest. */
+		static final class Call {
+
+			private final Thread thread = Thread.currentThread();
+
+			private final long deadline;
+
+			private boolean ended;
+
+			private boolean interrupted;
+
+			Call(Duration timeout) {
+				this.deadline = System.nanoTime() + timeout.toNanos();
+				calls.add(this);
+			}
+
+			private synchronized void interrupt() {
+				if (!this.ended && !this.interrupted) {
+					this.interrupted = true;
+					this.thread.interrupt();
+				}
+			}
+
+			/** After it no interrupt comes, for the pool's next task. */
+			synchronized void end() {
+				this.ended = true;
+				calls.remove(this);
+				if (this.interrupted) {
+					Thread.interrupted();
+				}
+			}
+
+		}
+
+	}
+
+	/** The instance serving one response. */
+	private final class Guest {
+
+		final Instance instance;
+
+		private final ByteArrayOutputStream written = new ByteArrayOutputStream();
+
+		private final List<String[]> edits = new ArrayList<>();
+
+		private int logs;
+
+		Guest() {
+			ImportValues imports = ImportValues.builder()
+				.withFunctions(List.of(new HostFunction("sluice", "counter", COUNTER, (instance, args) -> {
+					count(text(instance, args[0], args[1]), text(instance, args[2], args[3]), args[4]);
+					return null;
+				}), new HostFunction("sluice", "log", BYTES, (instance, args) -> {
+					guestLog(instance, args[0], args[1]);
+					return null;
+				}), new HostFunction("sluice", "write", BYTES, (instance, args) -> {
+					int limit = WasmResponseFilter.this.limits.maxWrite();
+					if (this.written.size() + (args[1] & 0xffffffffL) > limit) {
+						throw new GuestFailure("a write past " + limit + " bytes");
+					}
+					byte[] part = bytes(instance, args[0], args[1], limit);
+					this.written.write(part, 0, part.length);
+					return null;
+				}), new HostFunction("sluice", "header_set", BYTES_BYTES, (instance, args) -> {
+					edit(text(instance, args[0], args[1]), text(instance, args[2], args[3]));
+					return null;
+				}), new HostFunction("sluice", "header_remove", BYTES, (instance, args) -> {
+					edit(text(instance, args[0], args[1]), null);
+					return null;
+				})))
+				.build();
+			this.instance = guarded(() -> Instance.builder(WasmResponseFilter.this.module)
+				.withImportValues(imports)
+				.withMemoryLimits(new MemoryLimits(WasmResponseFilter.this.initialPages,
+						WasmResponseFilter.this.limits.maxPages()))
+				.build());
+		}
+
+		void check() {
+			long abi = guarded(() -> {
+				for (String export : List.of("sluice_buffer", "sluice_on_response", "sluice_on_data",
+						"sluice_on_end")) {
+					this.instance.export(export);
+				}
+				return this.instance.export("sluice_abi").apply()[0];
+			});
+			if (abi != ABI) {
+				throw new IllegalArgumentException(
+						WasmResponseFilter.this.name + " speaks ABI " + abi + ", the host " + ABI);
+			}
+		}
+
+		private void guestLog(Instance instance, long pointer, long length) {
+			if (this.logs++ < MAX_LOGS_PER_RESPONSE) {
+				String message = text(instance, pointer, Math.min(length & 0xffffffffL, MAX_LOG));
+				log.info("filter {}: {}", WasmResponseFilter.this.name, message.replaceAll("\\p{Cntrl}", "?"));
+			}
+		}
+
+		/** Checked at once, and applied only when the head's call returned. */
+		private void edit(String name, @Nullable String value) {
+			ResponseFilterPipe.checkEdit(name, value);
+			this.edits.add(new @Nullable String[] { name, value });
+		}
+
+		int onResponse(Request request, int status, Headers headers) {
+			StringBuilder head = new StringBuilder();
+			head.append(request.method()).append('\n').append(request.target()).append('\n');
+			head.append(request.host() == null ? "" : request.host()).append('\n').append(status).append('\n');
+			for (String line : headers.lines()) {
+				head.append(line).append('\n');
+			}
+			byte[] encoded = head.toString().getBytes(StandardCharsets.UTF_8);
+			int mode = (int) callWithInput("sluice_on_response", encoded, 0, encoded.length);
+			for (String[] edit : this.edits) {
+				if (edit[1] == null) {
+					headers.remove(edit[0]);
+				}
+				else {
+					headers.set(edit[0], edit[1]);
+				}
+			}
+			return mode;
+		}
+
+		/** Copies an input into the guest's memory and calls it with its length. */
+		private long callWithInput(String export, byte[] bytes, int offset, int length) {
+			return guarded(() -> {
+				long pointer = this.instance.export("sluice_buffer").apply(length)[0];
+				this.instance.memory().write((int) pointer, bytes, offset, length);
+				long[] result = this.instance.export(export).apply(length);
+				return result == null || result.length == 0 ? 0L : result[0];
+			});
+		}
+
+		private void call(String export, long... args) {
+			guarded(() -> {
+				ExportFunction function = this.instance.export(export);
+				return function.apply(args);
+			});
+		}
+
+		BodyObserver observer() {
+			return new BodyObserver() {
+
+				@Override
+				public void onData(byte[] bytes, int offset, int length) {
+					callWithInput("sluice_on_data", bytes, offset, length);
+				}
+
+				@Override
+				public void onEnd(boolean complete) {
+					call("sluice_on_end", complete ? 1 : 0);
+				}
+
+				@Override
+				public void onFailure(RuntimeException failure) {
+					failed("body", failure);
+				}
+
+			};
+		}
+
+		BodyRewriter rewriter() {
+			return new BodyRewriter() {
+
+				@Override
+				public byte[] onData(byte[] bytes, int offset, int length) {
+					try {
+						callWithInput("sluice_on_data", bytes, offset, length);
+						return drain();
+					}
+					catch (GuestFailure e) {
+						failed("rewrite", e);
+						throw e;
+					}
+				}
+
+				@Override
+				public byte[] onEnd() {
+					try {
+						call("sluice_on_end", 1);
+						return drain();
+					}
+					catch (GuestFailure e) {
+						failed("rewrite", e);
+						throw e;
+					}
+				}
+
+				private byte[] drain() {
+					byte[] bytes = Guest.this.written.toByteArray();
+					Guest.this.written.reset();
+					return bytes;
+				}
+
+			};
+		}
+
+		/**
+		 * Runs on a thread of {@link Watchdog#POOL}, the connection's virtual thread
+		 * waiting unmounted: a guest computing on it would hold a carrier, and with it
+		 * other connections, for as long as its call may run.
+		 */
+		private <T> T guarded(Supplier<T> action) {
+			Future<T> future = Watchdog.POOL.submit(() -> {
+				Watchdog.Call call = new Watchdog.Call(WasmResponseFilter.this.limits.callTimeout());
+				try {
+					return action.get();
+				}
+				catch (GuestFailure e) {
+					throw e;
+				}
+				catch (RuntimeException | StackOverflowError | OutOfMemoryError e) {
+					throw new GuestFailure(e.toString(), e);
+				}
+				finally {
+					call.end();
+				}
+			});
+			try {
+				return future.get();
+			}
+			catch (ExecutionException e) {
+				throw e.getCause() instanceof GuestFailure failure ? failure
+						: new GuestFailure(String.valueOf(e.getCause()), e);
+			}
+			catch (InterruptedException e) {
+				future.cancel(true);
+				Thread.currentThread().interrupt();
+				throw new GuestFailure("interrupted", e);
+			}
+		}
+
+	}
+
+}
