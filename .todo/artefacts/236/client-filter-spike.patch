+			int i = offset;
+			int end = offset + length;
+			while (i < end) {
+				switch (this.mode) {
+					case HEAD -> {
+						this.head.write(bytes[i++]);
+						if (bytes[i - 1] == '\n' && headEnd(this.head) > 0) {
+							onHead();
+						}
