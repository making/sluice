+++ b/sluice-client/src/test/java/am/ik/sluice/client/filter/ProxyWasmResponseFilterTest.java
@@ -0,0 +1,250 @@
+package am.ik.sluice.client.filter;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import io.micrometer.core.instrument.simple.SimpleMeterRegistry;
+import org.junit.jupiter.api.Test;
+
+import am.ik.sluice.tunnel.DuplexPipe;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/**
+ * Plugins of the proxy-wasm SDK, the SDK's own examples among them, interpreted by Endive
+ * behind the pipe: the same test on a JVM and, with {@code -PnativeTest}, on a native
+ * image.
+ */
+@SuppressWarnings("NullAway")
+class ProxyWasmResponseFilterTest {
+
+	private static final Path USAGE = Path.of("src/test/resources/wasm/llm_usage_proxy.wasm");
+
+	private static final Path MISBEHAVE = Path.of("src/test/resources/wasm/misbehave_proxy.wasm");
+
+	private static final Path HTTP_BODY = Path.of("src/test/resources/wasm/http_body.wasm");
+
+	private static final Path HTTP_HEADERS = Path.of("src/test/resources/wasm/http_headers.wasm");
+
+	private static final ProxyWasmResponseFilter.Limits ONE_VM = new ProxyWasmResponseFilter.Limits(1, 256,
+			Duration.ofMillis(200), 1024 * 1024, 16, false);
+
+	/** The head's lines but for the framing, then the payload of the body. */
+	private static String decoded(String response) {
+		int end = response.indexOf("\r\n\r\n");
+		StringBuilder decoded = new StringBuilder();
+		List<String> lines = new ArrayList<>(List.of(response.substring(0, end).split("\r\n")));
+		boolean chunked = lines.removeIf(line -> line.equalsIgnoreCase("transfer-encoding: chunked"));
+		decoded.append(String.join("\n", lines.stream().map(String::toLowerCase).sorted().toList())).append("\n\n");
+		String body = response.substring(end + 4);
+		byte[] bytes = body.getBytes(StandardCharsets.ISO_8859_1);
+		if (!chunked) {
+			return decoded.append(body).toString();
+		}
+		ByteArrayOutputStream payload = new ByteArrayOutputStream();
+		int at = 0;
+		while (true) {
+			int eol = at;
+			while (bytes[eol] != '\r') {
+				eol++;
+			}
+			int size = Integer.parseInt(new String(bytes, at, eol - at, StandardCharsets.US_ASCII), 16);
+			if (size == 0) {
+				break;
+			}
+			payload.write(bytes, eol + 2, size);
+			at = eol + 2 + size + 2;
+		}
+		return decoded.append(payload.toString(StandardCharsets.ISO_8859_1)).toString();
+	}
+
+	@Test
+	void usageOfEachApiReadAsTheBodyPasses() throws Exception {
+		for (WasmResponseFilterTest.Usage usage : WasmResponseFilterTest.usageCases()) {
+			for (int segment : new int[] { 1, 7, 64 * 1024 }) {
+				SimpleMeterRegistry registry = new SimpleMeterRegistry();
+				ProxyWasmResponseFilter filter = new ProxyWasmResponseFilter(USAGE, new byte[0], ONE_VM, registry);
+
+				String relayed = WasmResponseFilterTest.exchange(filter, "POST", usage.target(), usage.response(),
+						segment);
+
+				assertThat(decoded(relayed)).as(usage.target())
+					.isEqualTo(decoded(WasmResponseFilterTest.latin1(usage.response())));
+				assertThat(WasmResponseFilterTest.counters(registry)).as(usage.target() + " in segments of " + segment)
+					.isEqualTo(usage.expected());
+			}
+		}
+	}
+
+	@Test
+	void theSdksOwnExamplesRun() throws Exception {
+		SimpleMeterRegistry registry = new SimpleMeterRegistry();
+		ProxyWasmResponseFilter body = new ProxyWasmResponseFilter(HTTP_BODY, new byte[0], ONE_VM, registry);
+		String secret = "a secret";
+
+		// it pauses until the end, and has removed content-length
+		assertThat(decoded(WasmResponseFilterTest.exchange(body, "GET", "/",
+				"HTTP/1.1 200 OK\r\nContent-Length: 8\r\n\r\n" + secret, 3)))
+			.isEqualTo("http/1.1 200 ok\n\nOriginal message body (8 bytes) redacted.\n");
+		assertThat(decoded(WasmResponseFilterTest.exchange(body, "GET", "/",
+				"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\na s\r\n5\r\necret\r\n0\r\n\r\n", 4)))
+			.isEqualTo("http/1.1 200 ok\n\nOriginal message body (8 bytes) redacted.\n");
+		assertThat(decoded(WasmResponseFilterTest.exchange(body, "GET", "/",
+				"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nplain", 2)))
+			.isEqualTo("http/1.1 200 ok\n\nplain");
+
+		ProxyWasmResponseFilter headers = new ProxyWasmResponseFilter(HTTP_HEADERS, new byte[0], ONE_VM, registry);
+		String response = "HTTP/1.1 200 OK\r\nX-Name: Value\r\nContent-Length: 5\r\n\r\nplain";
+		assertThat(WasmResponseFilterTest.exchange(headers, "GET", "/", response, 1024)).isEqualTo(response);
+		// the SDK fails on what is not UTF-8: it reads as replacement characters, and the
+		// line stays as it came
+		String notUtf8 = "HTTP/1.1 200 OK\r\nX-Name: \u00ff\r\nContent-Length: 5\r\n\r\nplain";
+		assertThat(WasmResponseFilterTest.exchange(headers, "GET", "/", notUtf8.getBytes(StandardCharsets.ISO_8859_1),
+				1024))
+			.isEqualTo(notUtf8);
+		// a local response is not offered: the plugin's call fails, and the request goes
+		// on
+		assertThat(WasmResponseFilterTest.exchange(headers, "GET", "/hello", response, 1024)).isEqualTo(response);
+		assertThat(WasmResponseFilterTest.counters(registry)).isEqualTo(Map.of("guest.failures head", 1L));
+	}
+
+	@Test
+	void aMisbehavingPluginLeavesTheResponseAlone() throws Exception {
+		String sized = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabcde";
+		String chunked = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabcde\r\n0\r\n\r\n";
+		for (String target : List.of("/spin-request", "/trap-request", "/host", "/spin-head", "/trap-head", "/hog-head",
+				"/framing", "/smuggle", "/spin-body", "/trap-body", "/hog-body", "/replace-sized")) {
+			for (String response : List.of(sized, chunked)) {
+				if (target.equals("/replace-sized") && response == chunked) {
+					continue;
+				}
+				SimpleMeterRegistry registry = new SimpleMeterRegistry();
+				ProxyWasmResponseFilter filter = new ProxyWasmResponseFilter(MISBEHAVE, new byte[0], ONE_VM, registry);
+
+				String relayed = WasmResponseFilterTest.exchange(filter, "GET", target, response, 64 * 1024);
+
+				assertThat(decoded(relayed)).as(target).isEqualTo(decoded(response));
+				String phase = target.endsWith("-body") || target.equals("/replace-sized") ? "body" : "head";
+				assertThat(WasmResponseFilterTest.counters(registry)).as(target)
+					.isEqualTo(Map.of("guest.failures " + phase, 1L));
+				// the VM is started anew for the next stream
+				assertThat(WasmResponseFilterTest.exchange(filter, "GET", "/", sized, 1024)).isEqualTo(sized);
+			}
+		}
+	}
+
+	/** A stream on a VM another stream makes fail goes on, unseen from there. */
+	@Test
+	void aVmFailingEndsTheObservationOfItsOtherStreamsOnly() throws Exception {
+		SimpleMeterRegistry registry = new SimpleMeterRegistry();
+		ProxyWasmResponseFilter misbehaving = new ProxyWasmResponseFilter(MISBEHAVE, new byte[0], ONE_VM, registry);
+		ResponseFilter.Request request = new ResponseFilter.Request("a", "GET", "/observed", "HTTP/1.1", "h");
+
+		ResponseFilter.Exchange open = misbehaving.onRequest(request, new NoHeaders());
+		ResponseFilter.BodyHandler handler = open.onResponse(200, new NoHeaders(), false);
+		assertThat(handler).isInstanceOf(ResponseFilter.BodyObserver.class);
+		ResponseFilter.BodyObserver observer = (ResponseFilter.BodyObserver) handler;
+		observer.onData(new byte[] { 'a' }, 0, 1);
+
+		String sized = "HTTP/1.1 200 OK\r\nContent-Length: 1\r\n\r\nx";
+		assertThat(WasmResponseFilterTest.exchange(misbehaving, "GET", "/trap-body", sized, 1024)).isEqualTo(sized);
+
+		assertThatThrownBy(() -> observer.onData(new byte[] { 'b' }, 0, 1))
+			.isInstanceOf(WasmResponseFilter.GuestFailure.class);
+	}
+
+	@Test
+	void aPluginReplacesABodyAndAFailureCutsTheResponse() throws Exception {
+		SimpleMeterRegistry registry = new SimpleMeterRegistry();
+		ProxyWasmResponseFilter filter = new ProxyWasmResponseFilter(MISBEHAVE, new byte[0], ONE_VM, registry);
+		String chunked = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nabc\r\n2\r\nde\r\n0\r\n\r\n";
+
+		for (String response : List.of(chunked, "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nabcde")) {
+			assertThat(decoded(WasmResponseFilterTest.exchange(filter, "GET", "/replace", response, 1024)))
+				.isEqualTo("http/1.1 200 ok\n\nABCDE<end>");
+		}
+		assertThatThrownBy(() -> WasmResponseFilterTest.exchange(filter, "GET", "/replace-trap", chunked, 1024))
+			.isInstanceOf(IOException.class);
+	}
+
+	@Test
+	void whatAPluginSendsIsBoundedAndARequestHeadEdited() throws Exception {
+		SimpleMeterRegistry registry = new SimpleMeterRegistry();
+		ProxyWasmResponseFilter filter = new ProxyWasmResponseFilter(MISBEHAVE, new byte[0], ONE_VM, registry);
+
+		WasmResponseFilterTest.exchange(filter, "GET", "/meters", "HTTP/1.1 204 No Content\r\n\r\n", 1024);
+		assertThat(registry.find("sluice.client.filter.guest.meters").counters()).hasSize(16);
+		assertThat(registry.get("sluice.client.filter.guest.meters.dropped").counter().count()).isEqualTo(5000 - 16);
+
+		assertThat(WasmResponseFilterTest.exchange(filter, "GET", "/edit", "HTTP/1.1 204 No Content\r\nX-Up: 1\r\n\r\n",
+				1024))
+			.isEqualTo("HTTP/1.1 204 No Content\r\nX-Up: 1\r\nx-plugin: edited\r\n\r\n");
+
+		ByteArrayOutputStream upstream = new ByteArrayOutputStream();
+		try (ResponseFilterPipe pipe = new ResponseFilterPipe(new DuplexPipe() {
+
+			@Override
+			public InputStream source() {
+				return InputStream.nullInputStream();
+			}
+
+			@Override
+			public OutputStream sink() {
+				return upstream;
+			}
+
+			@Override
+			public void shutdownOutput() {
+			}
+
+			@Override
+			public void close() {
+			}
+
+		}, filter, "upstream:1")) {
+			pipe.sink()
+				.write("GET /request-edit HTTP/1.1\r\nHost: a\r\nX-Up: 1\r\n\r\n".getBytes(StandardCharsets.US_ASCII));
+		}
+		assertThat(upstream.toString(StandardCharsets.US_ASCII)).contains("x-plugin: request")
+			.contains("Host: a")
+			.contains("X-Up: 1");
+
+		assertThatThrownBy(() -> new ProxyWasmResponseFilter(Path.of("src/test/resources/wasm/misbehave.wasm"),
+				new byte[0], ONE_VM, registry))
+			.isInstanceOf(IllegalArgumentException.class);
+	}
+
+	private static final class NoHeaders implements ResponseFilter.Headers {
+
+		private final List<String> lines = new ArrayList<>();
+
+		@Override
+		public List<String> values(String name) {
+			return List.of();
+		}
+
+		@Override
+		public void set(String name, String value) {
+		}
+
+		@Override
+		public void remove(String name) {
+		}
+
+		@Override
+		public List<String> lines() {
+			return this.lines;
+		}
+
+	}
+
+}
diff --git a/sluice-client/src/test/java/am/ik/sluice/client/filter/WasmGuestCostProbe.java b/sluice-client/src/test/java/am/ik/sluice/client/filter/WasmGuestCostProbe.java
