@@ -0,0 +1,117 @@
+//! A guest for the host's tests: the request's path picks what it does.
+
+use core::hint::black_box;
+
+use sluice_filter::{Filter, Head, Mode, counter, filter, header_remove, header_set, log, write};
+
+#[derive(Default)]
+struct Misbehave {
+    path: String,
+}
+
+fn spin() -> ! {
+    loop {
+        black_box(0);
+    }
+}
+
+fn recurse(depth: u64) -> u64 {
+    let frame = black_box([depth; 64]);
+    recurse(depth + 1) + frame[black_box(0)]
+}
+
+static mut CALLS: u64 = 0;
+
+/// A frame of the interpreter's each call, none of the guest's own stack.
+#[inline(never)]
+fn deep() {
+    unsafe {
+        let calls = &raw mut CALLS;
+        calls.write_volatile(calls.read_volatile() + 1);
+        deep();
+        calls.write_volatile(calls.read_volatile() + 1);
+    }
+}
+
+fn hog() -> ! {
+    let mut held: Vec<Vec<u8>> = Vec::new();
+    loop {
+        held.push(vec![1; 1024 * 1024]);
+        black_box(&held);
+    }
+}
+
+impl Filter for Misbehave {
+    fn on_response(&mut self, head: &Head) -> Mode {
+        self.path = head.path().to_owned();
+        match head.path() {
+            "/spin-head" => spin(),
+            "/trap-head" => panic!(),
+            "/recurse-head" => {
+                black_box(recurse(0));
+                Mode::Pass
+            }
+            "/hog-head" => hog(),
+            "/deep-head" => {
+                deep();
+                Mode::Pass
+            }
+            "/protected" => {
+                header_set("x-guest", "applied only with the rest");
+                header_set("content-length", "1");
+                Mode::Pass
+            }
+            "/smuggle-value" => {
+                header_set("x-guest", "a\r\nx-smuggled: 1");
+                Mode::Pass
+            }
+            "/smuggle-name" => {
+                header_set("x-smuggled: 1\r\nx-guest", "a");
+                Mode::Pass
+            }
+            "/edit" => {
+                header_set("x-guest", "edited");
+                header_remove("x-upstream-private");
+                log("edited\r\nforged log line");
+                Mode::Pass
+            }
+            "/meters" => {
+                for i in 0..5000 {
+                    counter("guest.meters", &format!("i={i}"), 1);
+                }
+                Mode::Pass
+            }
+            "/spin-body" | "/trap-body" | "/hog-body" | "/observe" | "/silent" => Mode::Observe,
+            "/rewrite" | "/rewrite-trap" => {
+                header_set("x-guest", "rewritten");
+                Mode::Rewrite
+            }
+            _ => Mode::Pass,
+        }
+    }
+
+    fn on_data(&mut self, data: &[u8]) {
+        match self.path.as_str() {
+            "/spin-body" => spin(),
+            "/trap-body" => panic!(),
+            "/hog-body" => hog(),
+            "/observe" => counter("guest.bytes", "", data.len() as u64),
+            "/rewrite" => write(&data.to_ascii_uppercase()),
+            "/rewrite-trap" => {
+                write(b"PART");
+                panic!()
+            }
+            _ => {}
+        }
+    }
+
+    fn on_end(&mut self, complete: bool) {
+        match self.path.as_str() {
+            "/rewrite" => write(b"<end>"),
+            "/observe" => counter("guest.ends", if complete { "complete=true" } else { "complete=false" }, 1),
+            _ => {}
+        }
+    }
+}
+
+filter!(Misbehave);
