+package am.ik.sluice.client.filter;
+
+import java.io.ByteArrayOutputStream;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Path;
+import java.security.SecureRandom;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.CopyOnWriteArrayList;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Future;
+import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.Supplier;
+
+import io.micrometer.core.instrument.Counter;
+import io.micrometer.core.instrument.MeterRegistry;
+import io.micrometer.core.instrument.Tags;
+import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import run.endive.runtime.HostFunction;
+import run.endive.runtime.ImportFunction;
+import run.endive.runtime.ImportValues;
+import run.endive.runtime.Instance;
+import run.endive.runtime.Memory;
+import run.endive.runtime.WasmFunctionHandle;
+import run.endive.wasm.Parser;
+import run.endive.wasm.WasmModule;
+import run.endive.wasm.types.FunctionImport;
+import run.endive.wasm.types.FunctionType;
+import run.endive.wasm.types.MemoryLimits;
+
+/**
+ * A {@link ResponseFilter} that is a proxy-wasm plugin (ABI 0.2.1, spike), interpreted by
+ * Endive: what a user compiles with the proxy-wasm SDKs, as for Envoy.
+ *
+ * <p>
+ * As in a proxy, a VM serves many streams, one call at a time on its own thread: a stream
+ * costs a context, not an instance. There are as many VMs as processors, and a stream
+ * stays on its VM. A VM failing is discarded with its streams, and started anew for the
+ * next stream.
+ *
+ * <p>
+ * The body of a response can be replaced when it goes out chunked: the upstream's was, or
+ * the plugin removed {@code content-length}, as a plugin for Envoy must. Otherwise it is
+ * read-only. Offered of the ABI: the two heads, the response body, metrics, logs, time,
+ * randomness and the plugin's configuration. The rest answers {@code UNIMPLEMENTED}, the
+ * outgoing calls included: a plugin reaches nothing outside. Pausing a head is not
+ * offered; the request's body is not shown.
+ */
+public final class ProxyWasmResponseFilter implements ResponseFilter {
+
+	private static final Logger log = LoggerFactory.getLogger(ProxyWasmResponseFilter.class);
+
+	private static final int ROOT_CONTEXT = 1;
+
+	private static final int OK = 0;
+
+	private static final int NOT_FOUND = 1;
+
+	private static final int BAD_ARGUMENT = 2;
+
+	private static final int UNIMPLEMENTED = 12;
+
+	private static final int WASI_ENOSYS = 52;
+
+	private static final int WASI_SUCCESS = 0;
+
+	private static final int BUFFER_RESPONSE_BODY = 1;
+
+	private static final int BUFFER_PLUGIN_CONFIGURATION = 7;
+
+	private static final int MAP_REQUEST_HEADERS = 0;
+
+	private static final int MAP_RESPONSE_HEADERS = 2;
+
+	private static final int ACTION_PAUSE = 1;
+
+	private static final int METRIC_COUNTER = 0;
+
+	private static final int MAX_NAME = 16 * 1024;
+
+	private static final int MAX_TAG_VALUE = 128;
+
+	private static final SecureRandom RANDOM = new SecureRandom();
+
+	/**
+	 * What bounds a plugin.
+	 *
+	 * @param vms instances of the plugin
+	 * @param maxPages pages of 64KiB one VM may hold
+	 * @param callTimeout how long one call into the plugin may run
+	 * @param maxBody bytes of a body held while the plugin pauses it, or written by it
+	 * @param maxMeters metrics a plugin may define; past it they are dropped and counted
+	 * @param failClosed whether a failing plugin fails the responses it could not see
+	 */
+	public record Limits(int vms, int maxPages, Duration callTimeout, int maxBody, int maxMeters, boolean failClosed) {
+
+		public static Limits defaults() {
+			return new Limits(Runtime.getRuntime().availableProcessors(), 1024, Duration.ofSeconds(1), 16 * 1024 * 1024,
+					1024, false);
+		}
+
+	}
+
+	private final String name;
+
+	private final WasmModule module;
+
+	private final int initialPages;
+
+	private final byte[] configuration;
+
+	private final Limits limits;
+
+	private final MeterRegistry registry;
+
+	private final Vm[] vms;
+
+	private final AtomicInteger nextVm = new AtomicInteger();
+
+	private final Map<String, Integer> metricIds = new ConcurrentHashMap<>();
+
+	private final List<Counter> metrics = new CopyOnWriteArrayList<>();
+
+	private final Counter dropped;
+
+	public ProxyWasmResponseFilter(Path wasm, byte[] configuration, Limits limits, MeterRegistry registry) {
+		this.name = wasm.getFileName().toString().replaceFirst("\\.wasm$", "");
+		this.module = Parser.parse(wasm);
+		this.configuration = configuration.clone();
+		this.limits = limits;
+		this.registry = registry;
+		this.dropped = Counter.builder("sluice.client.filter.guest.meters.dropped")
+			.tag("filter", this.name)
+			.register(registry);
+		this.initialPages = this.module.memorySection()
+			.filter(memories -> memories.memoryCount() == 1)
+			.map(memories -> memories.getMemory(0).limits().initialPages())
+			.orElseThrow(() -> new IllegalArgumentException(this.name + " must define one memory"));
+		if (this.initialPages > limits.maxPages()) {
+			throw new IllegalArgumentException(
+					this.name + " needs " + this.initialPages + " pages, past the limit of " + limits.maxPages());
+		}
+		if (!exports("proxy_abi_version_0_2_1")) {
+			throw new IllegalArgumentException(this.name + " is not a plugin of proxy-wasm ABI 0.2.1");
+		}
+		this.module.importSection().stream().forEach(i -> {
+			if (i instanceof FunctionImport && !i.module().equals("env")
+					&& !i.module().equals("wasi_snapshot_preview1")) {
+				throw new IllegalArgumentException(this.name + " imports " + i.module() + "." + i.name());
+			}
+			if (!(i instanceof FunctionImport)) {
+				throw new IllegalArgumentException(this.name + " imports " + i.module() + "." + i.name());
+			}
+		});
+		this.vms = new Vm[limits.vms()];
+		for (int i = 0; i < this.vms.length; i++) {
+			this.vms[i] = new Vm(i);
+		}
+		// refused at the start, not on the first response
+		this.vms[0].run(() -> null);
+	}
+
+	private boolean exports(String export) {
+		for (int i = 0; i < this.module.exportSection().exportCount(); i++) {
+			if (this.module.exportSection().getExport(i).name().equals(export)) {
+				return true;
+			}
+		}
+		return false;
+	}
+
+	@Override
+	public @Nullable BodyHandler onResponse(Request request, int status, Headers headers) {
+		throw new UnsupportedOperationException("a stream's exchange answers");
+	}
+
+	@Override
+	public Exchange onRequest(Request request, Headers headers) {
+		Vm vm = this.vms[Math.floorMod(this.nextVm.getAndIncrement(), this.vms.length)];
+		try {
+			Stream stream = new Stream(vm, request);
+			stream.onRequestHeaders(headers);
+			return stream;
+		}
+		catch (WasmResponseFilter.GuestFailure e) {
+			failed("head", e);
+			if (this.limits.failClosed()) {
+				throw e;
+			}
+			return (status, responseHeaders, bodiless) -> null;
+		}
+	}
+
+	private void failed(String phase, Exception e) {
+		log.warn("filter {} failed on a {}: {}", this.name, phase, e.getMessage());
+		Counter.builder("sluice.client.filter.guest.failures")
+			.tag("filter", this.name)
+			.tag("phase", phase)
+			.register(this.registry)
+			.increment();
+	}
+
+	/** {@code name;key=value;...}: a metric's tags are in its name. */
+	private int defineMetric(String definition) {
+		Integer known = this.metricIds.get(definition);
+		if (known != null) {
+			return known;
+		}
+		if (this.metricIds.size() >= this.limits.maxMeters()) {
+			return -1;
+		}
+		String[] parts = definition.split(";");
+		Tags tags = Tags.of("filter", this.name);
+		for (int i = 1; i < parts.length; i++) {
+			int equals = parts[i].indexOf('=');
+			if (equals > 0 && !parts[i].startsWith("filter=")) {
+				String value = parts[i].substring(equals + 1);
+				tags = tags.and(parts[i].substring(0, equals),
+						value.length() > MAX_TAG_VALUE ? value.substring(0, MAX_TAG_VALUE) : value);
+			}
+		}
+		Counter counter = Counter.builder("sluice.client.filter." + parts[0]).tags(tags).register(this.registry);
+		synchronized (this.metricIds) {
+			return this.metricIds.computeIfAbsent(definition, key -> {
+				this.metrics.add(counter);
+				return this.metrics.size() - 1;
+			});
+		}
+	}
+
+	/** A plugin instance and the thread it runs on. */
+	private final class Vm {
+
+		private final ExecutorService thread;
+
+		private @Nullable Instance instance;
+
+		private int generation;
+
+		private int nextContext = ROOT_CONTEXT + 1;
+
+		private @Nullable Stream current;
+
+		Vm(int index) {
+			ThreadPoolExecutor pool = new ThreadPoolExecutor(1, 1, 30, TimeUnit.SECONDS, new LinkedBlockingQueue<>(),
+					Thread.ofPlatform().daemon().name("sluice-proxy-wasm-" + index).factory());
+			pool.allowCoreThreadTimeOut(true);
+			this.thread = pool;
+		}
+
+		/** Runs a task in the VM, started if it is not; a failure discards the VM. */
+		<T> T run(Supplier<T> task) {
+			Future<T> future = this.thread.submit(() -> {
+				WasmResponseFilter.Watchdog.Call call = new WasmResponseFilter.Watchdog.Call(
+						ProxyWasmResponseFilter.this.limits.callTimeout());
+				try {
+					if (this.instance == null) {
+						start();
+					}
+					return task.get();
+				}
+				catch (RuntimeException | StackOverflowError | OutOfMemoryError e) {
+					this.instance = null;
+					this.generation++;
+					this.nextContext = ROOT_CONTEXT + 1;
+					throw new WasmResponseFilter.GuestFailure(e.toString(), e);
+				}
+				finally {
+					this.current = null;
+					call.end();
+				}
+			});
+			try {
+				return future.get();
+			}
+			catch (ExecutionException e) {
+				throw e.getCause() instanceof WasmResponseFilter.GuestFailure failure ? failure
+						: new WasmResponseFilter.GuestFailure(String.valueOf(e.getCause()), e);
+			}
+			catch (InterruptedException e) {
+				future.cancel(true);
+				Thread.currentThread().interrupt();
+				throw new WasmResponseFilter.GuestFailure("interrupted", e);
+			}
+		}
+
+		private void start() {
+			ProxyWasmResponseFilter filter = ProxyWasmResponseFilter.this;
+			Instance started = Instance.builder(filter.module)
+				.withImportValues(imports())
+				.withMemoryLimits(new MemoryLimits(filter.initialPages, filter.limits.maxPages()))
+				.build();
+			started.export(filter.exports("_initialize") ? "_initialize" : "_start").apply();
+			started.export("proxy_on_context_create").apply(ROOT_CONTEXT, 0);
+			if (started.export("proxy_on_vm_start").apply(ROOT_CONTEXT, 0)[0] == 0
+					|| started.export("proxy_on_configure").apply(ROOT_CONTEXT, filter.configuration.length)[0] == 0) {
+				throw new WasmResponseFilter.GuestFailure("the plugin refused its start");
+			}
+			this.instance = started;
+		}
+
+		private Instance instance() {
+			Instance running = this.instance;
+			if (running == null) {
+				throw new WasmResponseFilter.GuestFailure("no VM");
+			}
+			return running;
+		}
+
+		long[] call(@Nullable Stream stream, String export, long... args) {
+			this.current = stream;
+			return instance().export(export).apply(args);
+		}
+
+		private ImportValues imports() {
+			List<ImportFunction> functions = new ArrayList<>();
+			ProxyWasmResponseFilter.this.module.importSection().stream().forEach(i -> {
+				FunctionImport function = (FunctionImport) i;
+				FunctionType type = ProxyWasmResponseFilter.this.module.typeSection().getType(function.typeIndex());
+				functions.add(new HostFunction(i.module(), i.name(), type, handle(i.module(), i.name(), type)));
+			});
+			return ImportValues.builder().withFunctions(functions).build();
+		}
+
+		private WasmFunctionHandle handle(String importModule, String importName, FunctionType type) {
+			if (importModule.equals("wasi_snapshot_preview1")) {
+				return switch (importName) {
+					case "clock_time_get" -> (instance, args) -> {
+						instance.memory().writeLong((int) args[2], System.currentTimeMillis() * 1_000_000L);
+						return status(WASI_SUCCESS);
+					};
+					case "random_get" -> (instance, args) -> {
+						byte[] random = new byte[Math.min((int) args[1], 1024 * 1024)];
+						RANDOM.nextBytes(random);
+						instance.memory().write((int) args[0], random);
+						return status(WASI_SUCCESS);
+					};
+					case "environ_sizes_get", "args_sizes_get" -> (instance, args) -> {
+						instance.memory().writeI32((int) args[0], 0);
+						instance.memory().writeI32((int) args[1], 0);
+						return status(WASI_SUCCESS);
+					};
+					case "environ_get", "args_get" -> (instance, args) -> status(WASI_SUCCESS);
+					case "fd_write" -> this::fdWrite;
+					case "proc_exit" -> (instance, args) -> {
+						throw new WasmResponseFilter.GuestFailure("the plugin exited with " + args[0]);
+					};
+					default -> (instance, args) -> stub(type, WASI_ENOSYS);
+				};
+			}
+			return switch (importName) {
+				case "proxy_log" -> (instance, args) -> {
+					pluginLog((int) args[0], text(instance, args[1], args[2]));
+					return status(OK);
+				};
+				case "proxy_get_log_level" -> (instance, args) -> {
+					instance.memory().writeI32((int) args[0], 2);
+					return status(OK);
+				};
+				case "proxy_get_current_time_nanoseconds" -> (instance, args) -> {
+					instance.memory().writeLong((int) args[0], System.currentTimeMillis() * 1_000_000L);
+					return status(OK);
+				};
+				case "proxy_set_effective_context", "proxy_done", "proxy_continue_stream" -> (instance, args) -> {
+					Stream stream = this.current;
+					if (importName.equals("proxy_continue_stream") && stream != null) {
+						stream.paused = false;
+					}
+					return status(OK);
+				};
+				case "proxy_get_buffer_bytes" -> this::getBuffer;
+				case "proxy_set_buffer_bytes" -> this::setBuffer;
+				case "proxy_get_buffer_status" -> (instance, args) -> {
+					byte[] buffer = buffer((int) args[0]);
+					if (buffer == null) {
+						return status(NOT_FOUND);
+					}
+					instance.memory().writeI32((int) args[1], buffer.length);
+					instance.memory().writeI32((int) args[2], 0);
+					return status(OK);
+				};
+				case "proxy_get_header_map_size" -> (instance, args) -> {
+					List<String[]> map = map((int) args[0]);
+					if (map == null) {
+						return status(NOT_FOUND);
+					}
+					instance.memory().writeI32((int) args[1], serialized(map).length);
+					return status(OK);
+				};
+				case "proxy_get_header_map_pairs" -> (instance, args) -> {
+					List<String[]> map = map((int) args[0]);
+					if (map == null) {
+						return status(NOT_FOUND);
+					}
+					giveBack(instance, serialized(map), args[1], args[2]);
+					return status(OK);
+				};
+				case "proxy_get_header_map_value" -> (instance, args) -> {
+					List<String[]> map = map((int) args[0]);
+					String key = text(instance, args[1], args[2]).toLowerCase(Locale.ROOT);
+					if (map != null) {
+						for (String[] pair : map) {
+							if (pair[0].equals(key)) {
+								giveBack(instance, pair[1].getBytes(StandardCharsets.UTF_8), args[3], args[4]);
+								return status(OK);
+							}
+						}
+					}
+					return status(NOT_FOUND);
+				};
+				case "proxy_replace_header_map_value", "proxy_add_header_map_value" -> (instance, args) -> {
+					boolean add = importName.equals("proxy_add_header_map_value");
+					return status(edit((int) args[0], text(instance, args[1], args[2]),
+							text(instance, args[3], args[4]), add));
+				};
+				case "proxy_remove_header_map_value" ->
+					(instance, args) -> status(edit((int) args[0], text(instance, args[1], args[2]), null, false));
+				case "proxy_define_metric" -> (instance, args) -> {
+					if (args[0] != METRIC_COUNTER) {
+						return status(BAD_ARGUMENT);
+					}
+					instance.memory().writeI32((int) args[3], defineMetric(text(instance, args[1], args[2])));
+					return status(OK);
+				};
+				case "proxy_increment_metric" -> (instance, args) -> {
+					int id = (int) args[0];
+					if (id < 0) {
+						ProxyWasmResponseFilter.this.dropped.increment();
+						return status(OK);
+					}
+					if (id >= ProxyWasmResponseFilter.this.metrics.size()) {
+						return status(NOT_FOUND);
+					}
+					if (args[1] < 0) {
+						return status(BAD_ARGUMENT);
+					}
+					ProxyWasmResponseFilter.this.metrics.get(id).increment(args[1]);
+					return status(OK);
+				};
+				case "proxy_get_property" -> this::getProperty;
+				default -> (instance, args) -> stub(type, UNIMPLEMENTED);
+			};
+		}
+
+		private long @Nullable [] stub(FunctionType type, int status) {
+			return type.returns().isEmpty() ? null : status(status);
+		}
+
+		private long[] fdWrite(Instance instance, long... args) {
+			Memory memory = instance.memory();
+			int vectors = (int) args[1];
+			int written = 0;
+			ByteArrayOutputStream text = new ByteArrayOutputStream();
+			for (int i = 0; i < vectors; i++) {
+				int at = (int) args[0] + i * 8;
+				byte[] part = bytes(instance, memory.readInt(at), memory.readInt(at + 4), MAX_NAME);
+				text.write(part, 0, part.length);
+				written += part.length;
+			}
+			memory.writeI32((int) args[3], written);
+			pluginLog(2, text.toString(StandardCharsets.UTF_8));
+			return status(WASI_SUCCESS);
+		}
+
+		private void pluginLog(int level, String message) {
+			String clean = message.replaceAll("\\p{Cntrl}", "?");
+			String trimmed = clean.length() > 1024 ? clean.substring(0, 1024) : clean;
+			if (level >= 3) {
+				log.warn("filter {}: {}", ProxyWasmResponseFilter.this.name, trimmed);
+			}
+			else if (level == 2) {
+				log.info("filter {}: {}", ProxyWasmResponseFilter.this.name, trimmed);
+			}
+			else {
+				log.debug("filter {}: {}", ProxyWasmResponseFilter.this.name, trimmed);
+			}
+		}
+
+		private byte @Nullable [] buffer(int type) {
+			Stream stream = this.current;
+			if (type == BUFFER_PLUGIN_CONFIGURATION) {
+				return ProxyWasmResponseFilter.this.configuration;
+			}
+			return type == BUFFER_RESPONSE_BODY && stream != null ? stream.body : null;
+		}
+
+		private long[] getBuffer(Instance instance, long... args) {
+			byte[] buffer = buffer((int) args[0]);
+			if (buffer == null) {
+				return status(NOT_FOUND);
+			}
+			long start = args[1] & 0xffffffffL;
+			long max = args[2] & 0xffffffffL;
+			if (start > buffer.length) {
+				return status(BAD_ARGUMENT);
+			}
+			int length = (int) Math.min(max, buffer.length - start);
+			byte[] part = new byte[length];
+			System.arraycopy(buffer, (int) start, part, 0, length);
+			giveBack(instance, part, args[3], args[4]);
+			return status(OK);
+		}
+
+		private long[] setBuffer(Instance instance, long... args) {
+			Stream stream = this.current;
+			if (args[0] != BUFFER_RESPONSE_BODY || stream == null || stream.body == null || !stream.replaceable) {
+				return status(NOT_FOUND);
+			}
+			byte[] value = bytes(instance, args[3], args[4], ProxyWasmResponseFilter.this.limits.maxBody());
+			byte[] body = stream.body;
+			long start = Math.min(args[1] & 0xffffffffL, body.length);
+			long size = Math.min(args[2] & 0xffffffffL, body.length - start);
+			byte[] replaced = new byte[(int) (body.length - size + value.length)];
+			System.arraycopy(body, 0, replaced, 0, (int) start);
+			System.arraycopy(value, 0, replaced, (int) start, value.length);
+			System.arraycopy(body, (int) (start + size), replaced, (int) start + value.length,
+					(int) (body.length - start - size));
+			if (replaced.length > ProxyWasmResponseFilter.this.limits.maxBody()) {
+				return status(BAD_ARGUMENT);
+			}
+			stream.body = replaced;
+			stream.modified = true;
+			return status(OK);
+		}
+
+		private long[] getProperty(Instance instance, long... args) {
+			Stream stream = this.current;
+			if (stream == null) {
+				return status(NOT_FOUND);
+			}
+			String path = text(instance, args[0], args[1]).replace('\0', '.');
+			String value = switch (path) {
+				case "request.path" -> stream.request.target();
+				case "request.method" -> stream.request.method();
+				case "request.host" -> stream.request.host();
+				case "response.code" -> stream.status == 0 ? null : Integer.toString(stream.status);
+				default -> null;
+			};
+			if (value == null) {
+				return status(NOT_FOUND);
+			}
+			giveBack(instance, value.getBytes(StandardCharsets.UTF_8), args[2], args[3]);
+			return status(OK);
+		}
+
+		private @Nullable List<String[]> map(int type) {
+			Stream stream = this.current;
+			if (stream == null) {
+				return null;
+			}
+			return switch (type) {
+				case MAP_REQUEST_HEADERS -> stream.requestHeaders;
+				case MAP_RESPONSE_HEADERS -> stream.responseHeaders;
+				default -> null;
+			};
+		}
+
+		/**
+		 * Only the head being offered can change, and takes effect when its call ends.
+		 */
+		private int edit(int type, String key, @Nullable String value, boolean add) {
+			Stream stream = this.current;
+			String lower = key.toLowerCase(Locale.ROOT);
+			if (stream == null || type != stream.editable) {
+				return BAD_ARGUMENT;
+			}
+			List<String[]> map = type == MAP_REQUEST_HEADERS ? stream.requestHeaders : stream.responseHeaders;
+			if (value == null && type == MAP_RESPONSE_HEADERS && lower.equals("content-length")) {
+				// what a plugin does to replace a body: chunked from here on
+				stream.contentLengthRemoved = true;
+				stream.edited |= map.removeIf(pair -> pair[0].equals(lower));
+				return OK;
+			}
+			if (lower.startsWith(":") || type == MAP_REQUEST_HEADERS && lower.equals("host")) {
+				return BAD_ARGUMENT;
+			}
+			String wire = value == null ? null
+					: new String(value.getBytes(StandardCharsets.UTF_8), StandardCharsets.ISO_8859_1);
+			try {
+				ResponseFilterPipe.checkEdit(lower, wire);
+			}
+			catch (IllegalArgumentException e) {
+				return BAD_ARGUMENT;
+			}
+			if (!add) {
+				stream.edited |= map.removeIf(pair -> pair[0].equals(lower));
+			}
+			if (value != null) {
+				map.add(new String[] { lower, value, lower + ": " + wire });
+				stream.edited = true;
+			}
+			return OK;
+		}
+
+		/** Into memory the plugin allocated, as the ABI has it. */
+		private void giveBack(Instance instance, byte[] bytes, long pointerAt, long sizeAt) {
+			long pointer = instance.export("proxy_on_memory_allocate").apply(bytes.length)[0];
+			if (pointer == 0 && bytes.length > 0) {
+				throw new WasmResponseFilter.GuestFailure("the plugin allocated nothing");
+			}
+			instance.memory().write((int) pointer, bytes);
+			instance.memory().writeI32((int) pointerAt, (int) pointer);
+			instance.memory().writeI32((int) sizeAt, bytes.length);
+		}
+
+	}
+
+	private static long[] status(int status) {
+		return new long[] { status };
+	}
+
+	private static String text(Instance instance, long pointer, long length) {
+		return new String(bytes(instance, pointer, length, MAX_NAME), StandardCharsets.UTF_8);
+	}
+
+	/** The plugin's pointers are not trusted; the memory checks the range. */
+	private static byte[] bytes(Instance instance, long pointer, long length, int limit) {
+		int len = (int) length;
+		if (len < 0 || len > limit) {
+			throw new WasmResponseFilter.GuestFailure("a length of " + (length & 0xffffffffL) + " past " + limit);
+		}
+		return instance.memory().readBytes((int) pointer, len);
+	}
+
+	/**
+	 * {@code count, (name size, value size)..., (name NUL, value NUL)...}, little endian.
+	 */
+	private static byte[] serialized(List<String[]> map) {
+		List<byte[]> parts = new ArrayList<>();
+		int size = 4 + map.size() * 8;
+		for (String[] pair : map) {
+			for (int i = 0; i < 2; i++) {
+				byte[] bytes = pair[i].getBytes(StandardCharsets.UTF_8);
+				parts.add(bytes);
+				size += bytes.length + 1;
+			}
+		}
+		ByteBuffer out = ByteBuffer.allocate(size).order(ByteOrder.LITTLE_ENDIAN);
+		out.putInt(map.size());
+		for (byte[] part : parts) {
+			out.putInt(part.length);
+		}
+		for (byte[] part : parts) {
+			out.put(part).put((byte) 0);
+		}
+		return out.array();
+	}
+
+	/**
+	 * A head's text as a plugin reads it: the SDKs take a header as UTF-8 and fail on
+	 * anything else, which a client must not be able to make happen. What is not UTF-8
+	 * reads as replacement characters; the line itself stays as it came.
+	 */
+	private static String readable(String wire) {
+		return new String(wire.getBytes(StandardCharsets.ISO_8859_1), StandardCharsets.UTF_8);
+	}
+
+	/** {@code name, value as read, the line as it came or null}. */
+	private static List<String[]> pairs(List<String> lines) {
+		List<String[]> pairs = new ArrayList<>();
+		for (String line : lines) {
+			int colon = line.indexOf(':');
+			if (colon > 0) {
+				pairs.add(new String[] { line.substring(0, colon).trim().toLowerCase(Locale.ROOT),
+						readable(line.substring(colon + 1).trim()), line });
+			}
+		}
+		return pairs;
+	}
+
+	/**
+	 * Puts a head's fields back, the plugin's edits among them, but for the pseudo ones.
+	 */
+	private static void apply(List<String[]> pairs, Headers headers) {
+		List<String> lines = headers.lines();
+		lines.clear();
+		for (String[] pair : pairs) {
+			if (!pair[0].startsWith(":")) {
+				lines.add(pair[2]);
+			}
+		}
+	}
+
+	/** One request and its response: a context of a VM. */
+	private final class Stream implements Exchange {
+
+		private final Vm vm;
+
+		final Request request;
+
+		private final int generation;
+
+		private final int context;
+
+		/** The call ending the stream has been made, or the VM is gone. */
+		private boolean closed;
+
+		List<String[]> requestHeaders = new ArrayList<>();
+
+		List<String[]> responseHeaders = new ArrayList<>();
+
+		int editable = -1;
+
+		/** The plugin changed the head being offered: its fields are written back. */
+		boolean edited;
+
+		int status;
+
+		boolean contentLengthRemoved;
+
+		byte @Nullable [] body;
+
+		boolean replaceable;
+
+		boolean modified;
+
+		boolean paused;
+
+		private final ByteArrayOutputStream held = new ByteArrayOutputStream();
+
+		Stream(Vm vm, Request request) {
+			this.vm = vm;
+			this.request = request;
+			int[] started = vm.run(() -> {
+				int id = vm.nextContext++;
+				vm.call(null, "proxy_on_context_create", id, ROOT_CONTEXT);
+				return new int[] { vm.generation, id };
+			});
+			this.generation = started[0];
+			this.context = started[1];
+		}
+
+		private boolean gone() {
+			return this.closed || this.generation != this.vm.generation;
+		}
+
+		/** A failure on the stream's VM ends the stream, as it ended the others'. */
+		private void onRequestHeaders(Headers headers) {
+			this.requestHeaders.add(new String[] { ":method", this.request.method(), "" });
+			this.requestHeaders.add(new String[] { ":path", readable(this.request.target()), "" });
+			this.requestHeaders.add(new String[] { ":scheme", "http", "" });
+			if (this.request.host() != null) {
+				this.requestHeaders.add(new String[] { ":authority", readable(this.request.host()), "" });
+			}
+			this.requestHeaders.addAll(pairs(headers.lines()));
+			try {
+				this.vm.run(() -> {
+					this.editable = MAP_REQUEST_HEADERS;
+					this.vm.call(this, "proxy_on_request_headers", this.context, this.requestHeaders.size(), 0);
+					this.editable = -1;
+					if (this.edited) {
+						apply(this.requestHeaders, headers);
+					}
+					this.edited = false;
+					return null;
+				});
+			}
+			catch (WasmResponseFilter.GuestFailure e) {
+				failedHead(e);
+			}
+		}
+
+		private void failedHead(WasmResponseFilter.GuestFailure e) {
+			this.closed = true;
+			failed("head", e);
+			if (ProxyWasmResponseFilter.this.limits.failClosed()) {
+				throw e;
+			}
+		}
+
+		@Override
+		public @Nullable BodyHandler onResponse(int status, Headers headers, boolean bodiless) {
+			if (gone()) {
+				return null;
+			}
+			List<String[]> edited = new ArrayList<>();
+			edited.add(new String[] { ":status", Integer.toString(status), "" });
+			edited.addAll(pairs(headers.lines()));
+			this.responseHeaders = edited;
+			this.status = status;
+			boolean chunked = !headers.values("transfer-encoding").isEmpty();
+			boolean sized = !headers.values("content-length").isEmpty();
+			try {
+				this.vm.run(() -> {
+					this.editable = MAP_RESPONSE_HEADERS;
+					// a head's pause is not offered: it goes on as it would
+					this.vm.call(this, "proxy_on_response_headers", this.context, edited.size(), bodiless ? 1 : 0);
+					this.editable = -1;
+					return null;
+				});
+			}
+			catch (WasmResponseFilter.GuestFailure e) {
+				failedHead(e);
+				return null;
+			}
+			if (this.edited) {
+				apply(edited, headers);
+			}
+			if (bodiless) {
+				close();
+				return null;
+			}
+			if (chunked || sized && this.contentLengthRemoved) {
+				this.replaceable = true;
+				return new Replacing();
+			}
+			return new Reading();
+		}
+
+		@Override
+		public void abandon() {
+			close();
+		}
+
+		/** The ABI's end of a stream, whatever its response came to. */
+		private void close() {
+			if (gone()) {
+				return;
+			}
+			this.closed = true;
+			try {
+				this.vm.run(() -> {
+					if (this.generation == this.vm.generation) {
+						if (this.vm.call(this, "proxy_on_done", this.context)[0] != 0) {
+							this.vm.call(this, "proxy_on_log", this.context);
+							this.vm.call(this, "proxy_on_delete", this.context);
+						}
+					}
+					return null;
+				});
+			}
+			catch (WasmResponseFilter.GuestFailure e) {
+				failed("close", e);
+			}
+		}
+
+		/** Calls the plugin on the body as it stands; whether it paused. */
+		private boolean onBody(boolean end) {
+			return this.vm.run(() -> {
+				if (this.generation != this.vm.generation) {
+					throw new WasmResponseFilter.GuestFailure("the VM was discarded");
+				}
+				byte[] current = this.body;
+				long action = this.vm.call(this, "proxy_on_response_body", this.context,
+						current == null ? 0 : current.length, end ? 1 : 0)[0];
+				return action == ACTION_PAUSE;
+			});
+		}
+
+		/** A body going out as the upstream framed it: the plugin only reads it. */
+		private final class Reading implements BodyObserver {
+
+			@Override
+			public void onData(byte[] bytes, int offset, int length) {
+				Stream.this.body = Arrays.copyOfRange(bytes, offset, offset + length);
+				onBody(false);
+				Stream.this.body = null;
+			}
+
+			@Override
+			public void onEnd(boolean complete) {
+				if (complete) {
+					Stream.this.body = new byte[0];
+					onBody(true);
+					Stream.this.body = null;
+				}
+				close();
+			}
+
+			@Override
+			public void onFailure(RuntimeException failure) {
+				Stream.this.closed = true;
+				failed("body", failure);
+			}
+
+		}
+
+		/**
+		 * A body going out chunked: what the plugin left of it, when it stops pausing.
+		 */
+		private final class Replacing implements BodyRewriter {
+
+			private boolean passing;
+
+			private byte[] step(byte @Nullable [] bytes, int offset, int length, boolean end) {
+				byte[] part = bytes == null ? new byte[0] : Arrays.copyOfRange(bytes, offset, offset + length);
+				if (this.passing) {
+					return part;
+				}
+				Stream stream = Stream.this;
+				stream.held.write(part, 0, part.length);
+				if (stream.held.size() > ProxyWasmResponseFilter.this.limits.maxBody()) {
+					throw new WasmResponseFilter.GuestFailure("a body held past its limit");
+				}
+				stream.body = stream.held.toByteArray();
+				boolean heldBefore = stream.held.size() > part.length;
+				try {
+					stream.paused = onBody(end) && !end;
+				}
+				catch (WasmResponseFilter.GuestFailure e) {
+					failed("body", e);
+					stream.closed = true;
+					// what no one changed can go on; otherwise the response is cut
+					if (stream.modified || heldBefore || ProxyWasmResponseFilter.this.limits.failClosed()) {
+						throw e;
+					}
+					this.passing = true;
+					stream.body = null;
+					stream.held.reset();
+					return part;
+				}
+				if (stream.paused) {
+					if (stream.modified) {
+						stream.held.reset();
+						byte[] kept = stream.body;
+						stream.held.write(kept, 0, kept.length);
+					}
+					stream.body = null;
+					return new byte[0];
+				}
+				byte[] out = stream.body;
+				stream.body = null;
+				stream.held.reset();
+				return out;
+			}
+
+			@Override
+			public byte[] onData(byte[] bytes, int offset, int length) {
+				return step(bytes, offset, length, false);
+			}
+
+			@Override
+			public byte[] onEnd() {
+				return step(null, 0, 0, true);
+			}
+
+			@Override
+			public void onClose() {
+				close();
+			}
+
+		}
+
+	}
+
+}
