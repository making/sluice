+++ b/sluice-client/src/main/java/am/ik/sluice/client/filter/ResponseFilterPipe.java
@@ -0,0 +1,764 @@
+package am.ik.sluice.client.filter;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Queue;
+import java.util.Set;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.locks.ReentrantLock;
+import java.util.regex.Pattern;
+
+import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import am.ik.sluice.tunnel.DuplexPipe;
+
+/**
+ * An upstream connection the server speaks HTTP/1.1 on, its responses passing a
+ * {@link ResponseFilter} (spike): the request side is followed to know what each response
+ * answers, the response side is parsed and rewritten as the relay reads it. The server's
+ * relay sees an ordinary upstream: whatever comes out here is framed, or ends as the
+ * upstream ended. A response the parse cannot follow, and a connection past a 101, are
+ * relayed as they are.
+ */
+public final class ResponseFilterPipe implements DuplexPipe {
+
+	private static final Logger log = LoggerFactory.getLogger(ResponseFilterPipe.class);
+
+	private static final int MAX_HEAD = 64 * 1024;
+
+	private static final Pattern TOKEN = Pattern.compile("[!#$%&'*+.^_`|~0-9A-Za-z-]+");
+
+	/** Framing, and what the relay follows: a filter cannot change them. */
+	private static final Set<String> PROTECTED = Set.of("content-length", "transfer-encoding", "connection", "upgrade",
+			"keep-alive", "proxy-connection", "te", "trailer");
+
+	private static final byte[] CRLF = { '\r', '\n' };
+
+	private final DuplexPipe upstream;
+
+	private final ResponseFilter filter;
+
+	private final String address;
+
+	private final Queue<Pending> requests = new ConcurrentLinkedQueue<>();
+
+	private final OutputStream sink;
+
+	private final ResponseSide source;
+
+	/** A 101 or a CONNECT's 2xx passed: only bytes from here on. */
+	private volatile boolean verbatim;
+
+	public ResponseFilterPipe(DuplexPipe upstream, ResponseFilter filter, String address) {
+		this.upstream = upstream;
+		this.filter = filter;
+		this.address = address;
+		this.sink = new RequestSide(upstream.sink());
+		this.source = new ResponseSide(upstream.source());
+	}
+
+	@Override
+	public InputStream source() {
+		return this.source;
+	}
+
+	@Override
+	public OutputStream sink() {
+		return this.sink;
+	}
+
+	@Override
+	public void shutdownOutput() throws Exception {
+		this.upstream.shutdownOutput();
+	}
+
+	@Override
+	public void close() throws Exception {
+		try {
+			this.upstream.close();
+		}
+		finally {
+			this.source.endObserving(false);
+			Pending pending;
+			while ((pending = this.requests.poll()) != null) {
+				pending.exchange().abandon();
+			}
+		}
+	}
+
+	private record Pending(ResponseFilter.Request request, ResponseFilter.Exchange exchange) {
+	}
+
+	/**
+	 * Refuses an edit a head cannot take, a filter's name or value being untrusted: the
+	 * framing the relay follows, or what would make a line of its own.
+	 * @param value null for a removal
+	 */
+	static void checkEdit(String name, @Nullable String value) {
+		if (!TOKEN.matcher(name).matches() || PROTECTED.contains(name.toLowerCase(Locale.ROOT))) {
+			throw new IllegalArgumentException("header " + name + " cannot be changed by a filter");
+		}
+		if (value != null) {
+			for (int i = 0; i < value.length(); i++) {
+				char c = value.charAt(i);
+				if (c < 0x20 && c != '\t' || c == 0x7f || c > 0xff) {
+					throw new IllegalArgumentException("invalid value of header " + name);
+				}
+			}
+		}
+	}
+
+	private static int headEnd(ByteArrayOutputStream head) {
+		byte[] bytes = head.toByteArray();
+		int n = bytes.length;
+		return n >= 4 && bytes[n - 4] == '\r' && bytes[n - 3] == '\n' && bytes[n - 2] == '\r' && bytes[n - 1] == '\n'
+				? n : -1;
+	}
+
+	private static List<String> lines(byte[] head) {
