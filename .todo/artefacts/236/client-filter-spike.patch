@@ -0,0 +1,163 @@
+//! The guest side of the response filter ABI (version 1), a module with no WASI.
+//!
+//! Exports: `memory`, `sluice_abi() -> 1`, `sluice_buffer(len) -> ptr` (where the host
+//! writes the next input), `sluice_on_response(len) -> mode`, `sluice_on_data(len)`,
+//! `sluice_on_end(complete)`. One instance serves one response.
+
+#[link(wasm_import_module = "sluice")]
+unsafe extern "C" {
+    #[link_name = "counter"]
+    fn host_counter(name: *const u8, name_len: i32, tags: *const u8, tags_len: i32, value: i64);
+    #[link_name = "log"]
+    fn host_log(text: *const u8, len: i32);
+    #[link_name = "write"]
+    fn host_write(bytes: *const u8, len: i32);
+    #[link_name = "header_set"]
+    fn host_header_set(name: *const u8, name_len: i32, value: *const u8, value_len: i32);
+    #[link_name = "header_remove"]
+    fn host_header_remove(name: *const u8, name_len: i32);
+}
+
+/// What the guest does with a response's body.
+#[derive(Clone, Copy)]
+pub enum Mode {
+    /// The body is relayed unseen, and the instance dropped.
+    Pass = 0,
+    /// The body is relayed as sent, and shown to the guest.
+    Observe = 1,
+    /// The guest's [`write`]s replace the body, chunked.
+    Rewrite = 2,
+}
+
+/// A final response head and the request it answers.
+pub struct Head<'a> {
+    pub method: &'a str,
+    pub target: &'a str,
+    pub host: &'a str,
+    pub status: u16,
+    text: &'a str,
+}
+
+impl Head<'_> {
+    fn parse(text: &str) -> Head<'_> {
+        let mut lines = text.splitn(5, '\n');
+        let method = lines.next().unwrap_or("");
+        let target = lines.next().unwrap_or("");
+        let host = lines.next().unwrap_or("");
+        let status = lines.next().and_then(|s| s.parse().ok()).unwrap_or(0);
+        Head { method, target, host, status, text: lines.next().unwrap_or("") }
+    }
+
+    /// The request's path, without its query.
+    pub fn path(&self) -> &str {
+        self.target.split('?').next().unwrap_or("")
+    }
+
+    /// The header's first value; the name in lower case.
+    pub fn header(&self, name: &str) -> Option<&str> {
+        self.text.lines().find_map(|line| {
+            let (n, v) = line.split_once(':')?;
+            n.eq_ignore_ascii_case(name).then(|| v.trim())
+        })
+    }
+}
+
+pub trait Filter: Default {
+    fn on_response(&mut self, head: &Head) -> Mode;
+    fn on_data(&mut self, _data: &[u8]) {}
+    fn on_end(&mut self, _complete: bool) {}
+}
+
+/// Adds to a counter `sluice.client.filter.<name>`; tags are `key=value` lines.
+pub fn counter(name: &str, tags: &str, value: u64) {
+    unsafe { host_counter(name.as_ptr(), name.len() as i32, tags.as_ptr(), tags.len() as i32, value as i64) }
+}
+
+pub fn log(text: &str) {
+    unsafe { host_log(text.as_ptr(), text.len() as i32) }
+}
+
+/// A part of the rewritten body.
+pub fn write(bytes: &[u8]) {
+    unsafe { host_write(bytes.as_ptr(), bytes.len() as i32) }
+}
+
+pub fn header_set(name: &str, value: &str) {
+    unsafe { host_header_set(name.as_ptr(), name.len() as i32, value.as_ptr(), value.len() as i32) }
+}
+
+pub fn header_remove(name: &str) {
+    unsafe { host_header_remove(name.as_ptr(), name.len() as i32) }
+}
+
+/// Implementation detail of [`filter!`].
+pub mod glue {
+    use super::*;
+
+    pub struct State<F> {
+        pub filter: Option<F>,
+        pub input: Vec<u8>,
+    }
+
+    pub fn buffer<F>(state: &mut State<F>, len: usize) -> *mut u8 {
+        state.input.resize(len, 0);
+        state.input.as_mut_ptr()
+    }
+
+    pub fn on_response<F: Filter>(state: &mut State<F>, len: usize) -> i32 {
+        let filter = state.filter.get_or_insert_with(F::default);
+        let text = core::str::from_utf8(&state.input[..len]).unwrap_or("");
+        filter.on_response(&Head::parse(text)) as i32
+    }
+
+    pub fn on_data<F: Filter>(state: &mut State<F>, len: usize) {
+        if let Some(filter) = state.filter.as_mut() {
+            filter.on_data(&state.input[..len]);
+        }
+    }
+
+    pub fn on_end<F: Filter>(state: &mut State<F>, complete: bool) {
+        if let Some(filter) = state.filter.as_mut() {
+            filter.on_end(complete);
+        }
+    }
+}
+
+/// Exports the ABI for a [`Filter`].
+#[macro_export]
+macro_rules! filter {
+    ($filter:ty) => {
+        static mut STATE: $crate::glue::State<$filter> =
+            $crate::glue::State { filter: None, input: Vec::new() };
+
+        #[allow(static_mut_refs)]
+        fn state() -> &'static mut $crate::glue::State<$filter> {
+            unsafe { &mut *(&raw mut STATE) }
+        }
+
+        #[unsafe(no_mangle)]
+        pub extern "C" fn sluice_abi() -> i32 {
+            1
+        }
+
+        #[unsafe(no_mangle)]
+        pub extern "C" fn sluice_buffer(len: i32) -> *mut u8 {
+            $crate::glue::buffer(state(), len as usize)
+        }
+
+        #[unsafe(no_mangle)]
+        pub extern "C" fn sluice_on_response(len: i32) -> i32 {
+            $crate::glue::on_response(state(), len as usize)
+        }
+
+        #[unsafe(no_mangle)]
+        pub extern "C" fn sluice_on_data(len: i32) {
+            $crate::glue::on_data(state(), len as usize)
+        }
+
+        #[unsafe(no_mangle)]
+        pub extern "C" fn sluice_on_end(complete: i32) {
+            $crate::glue::on_end(state(), complete != 0)
+        }
+    };
+}
