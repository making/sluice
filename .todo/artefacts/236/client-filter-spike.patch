+	private final class RequestSide extends OutputStream {
+
+		private final OutputStream out;
+
+		private final ByteArrayOutputStream head = new ByteArrayOutputStream(512);
+
+		private final ByteArrayOutputStream line = new ByteArrayOutputStream(32);
+
+		private Mode mode = Mode.HEAD;
+
+		private long remaining;
+
+		private enum Mode {
+
+			HEAD, BODY, CHUNK_SIZE, CHUNK_DATA, CHUNK_CRLF, TRAILERS
+
+		}
