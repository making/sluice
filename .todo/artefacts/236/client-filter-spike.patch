+			check(name, null);
+			String lower = name.toLowerCase(Locale.ROOT);
+			for (int i = this.lines.size() - 1; i >= 1; i--) {
+				if (nameOf(this.lines.get(i)).equals(lower)) {
+					this.lines.remove(i);
+				}
+			}
+		}
+
+	}
