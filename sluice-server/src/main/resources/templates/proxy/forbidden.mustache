<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex">
  <!--
    The console's brand mark as a data URI: the data plane cannot serve the console
    assets, and a link to /console/img/logo.svg would itself hit this 403 page.
  -->
  <link rel="icon" type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Cpath%20d='M3%209h9M3%2023h9M20%209h9M20%2023h9'%20fill='none'%20stroke='%23143b69'%20stroke-width='1.5'/%3E%3Cpath%20d='M12%209l4%207M12%2023l4-7'%20fill='none'%20stroke='%23143b69'%20stroke-width='2.5'%20stroke-linecap='round'/%3E%3Cpath%20d='M2%2016h8M22%2016h8'%20fill='none'%20stroke='%231b86c2'%20stroke-width='1.5'%20stroke-dasharray='2%203'/%3E%3C/svg%3E">
  <title>Forbidden - sluice</title>
  <!--
    Served by the data plane, which cannot reach the console assets on the management
    port: the console's sheet styling is inlined here, fonts fall back to system faces.
  -->
  <style>
    :root {
      --paper: #f3f6f9;
      --paper-raised: #e9eff5;
      --ink: #143b69;
      --ink-soft: #4b6789;
      --hair: rgb(20 59 105 / 0.32);
      --hair-faint: rgb(20 59 105 / 0.14);
      --grid: rgb(20 59 105 / 0.045);
      --grid-major: rgb(20 59 105 / 0.085);
      --water: #1b86c2;
      --water-bed: rgb(27 134 194 / 0.16);
      --fault: #c0392b;
      --sans: "Overpass", "Helvetica Neue", Arial, sans-serif;
      --mono: "Overpass Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
      --gutter: clamp(16px, 3.2vw, 44px);
      color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --paper: #0f2d52;
        --paper-raised: #0c2646;
        --ink: #e4edf7;
        --ink-soft: #a9bdd4;
        --hair: rgb(228 237 247 / 0.34);
        --hair-faint: rgb(228 237 247 / 0.14);
        --grid: rgb(228 237 247 / 0.045);
        --grid-major: rgb(228 237 247 / 0.09);
        --water: #6fd0f5;
        --water-bed: rgb(111 208 245 / 0.2);
        --fault: #ff8a7a;
        color-scheme: dark;
      }
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 0.9375rem;
      line-height: 1.5;
      background-color: var(--paper);
      background-image:
        linear-gradient(var(--grid-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-major) 1px, transparent 1px),
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
      background-position: -1px -1px;
    }
    .mono { font-family: var(--mono); font-size: 0.92em; letter-spacing: -0.01em; overflow-wrap: anywhere; }
    .masthead { max-width: 1080px; margin: 0 auto; padding: 1.25rem var(--gutter) 0; }
    .brand { display: inline-flex; align-items: baseline; gap: 0.55rem; }
    .brand__mark { align-self: center; width: 30px; height: 30px; }
    .brand__word { font-size: 1.46rem; font-weight: 700; letter-spacing: -0.02em; }
    .sheet { position: relative; max-width: 1080px; margin: 1.25rem auto 3rem; padding: 0 var(--gutter); }
    .sheet__drawing {
      padding: clamp(1rem, 2.5vw, 2rem) clamp(1rem, 3vw, 2.5rem) clamp(5.5rem, 8vw, 6.5rem);
      border: 1px solid var(--hair);
      outline: 1px solid var(--hair-faint);
      outline-offset: 5px;
      background: color-mix(in srgb, var(--paper) 72%, transparent);
    }
    .drawing { display: block; width: 100%; height: auto; overflow: visible; font-family: var(--sans); }
    .drawing text { fill: var(--ink-soft); font-size: 13px; }
    .bank { fill: none; stroke: var(--hair); stroke-width: 54.5; }
    .bed { fill: none; stroke: var(--paper); stroke-width: 52; }
    .water { fill: none; stroke: var(--water-bed); stroke-width: 52; }
    .stream {
      fill: none;
      stroke: var(--water);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-dasharray: 1.5 11;
      animation: stream 2.4s linear infinite;
    }
    .dry { fill: none; stroke: var(--hair); stroke-width: 1.25; stroke-dasharray: 5 7; }
    .wall { fill: url(#hatch); stroke: var(--ink); stroke-width: 1.25; }
    .hatch-line { stroke: var(--hair); stroke-width: 1; }
    .leaf { stroke: var(--fault); stroke-width: 5; stroke-linecap: round; }
    .hinge { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
    .leader { fill: none; stroke: var(--ink-soft); stroke-width: 0.75; }
    .drawing .fault { fill: var(--fault); font-weight: 700; }
    .ink { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.3s cubic-bezier(0.6, 0, 0.3, 1) forwards; }
    .gate .ink { animation-delay: 0.35s; }
    @keyframes stream { to { stroke-dashoffset: -12.5; } }
    @keyframes draw { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) {
      .ink { animation: none; stroke-dasharray: none; stroke-dashoffset: 0; }
      .stream { animation: none; }
    }
    .notice { max-width: 40rem; margin-top: clamp(1rem, 3vw, 2rem); }
    .status { margin: 0; color: var(--fault); font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    h1 { margin: 0.2rem 0 0.9rem; font-size: clamp(1.83rem, 4vw, 2.86rem); font-weight: 300; letter-spacing: -0.03em; line-height: 1.1; }
    .lede { margin: 0 0 0.5rem; font-size: 1.17rem; }
    .hint { margin: 0; color: var(--ink-soft); }
    .sheet__title { position: absolute; right: var(--gutter); bottom: 0; max-width: calc(100% - 2 * var(--gutter)); }
    .titleblock {
      display: grid;
      grid-template-columns: auto minmax(0, auto) minmax(0, auto);
      margin: 0;
      border-top: 1px solid var(--hair);
      border-left: 1px solid var(--hair);
      background: var(--paper-raised);
      font-size: 0.8125rem;
    }
    .titleblock div {
      display: flex;
      flex-direction: column;
      gap: 0.05rem;
      min-width: 7.5rem;
      padding: 0.4rem 0.8rem 0.45rem;
      border-right: 1px solid var(--hair-faint);
      border-bottom: 1px solid var(--hair-faint);
    }
    .titleblock dt { color: var(--ink-soft); font-size: 0.72rem; }
    .titleblock dd { margin: 0; font-weight: 600; }
    .titleblock .titleblock__status dd { color: var(--fault); font-size: 1.46rem; line-height: 1.2; }
    @media (max-width: 640px) {
      .sheet__drawing { padding-bottom: 1rem; }
      /* scaled down, the drawing's labels fall below legible size; the notice says it */
      .drawing text, .drawing .leader { display: none; }
      .sheet__title { position: static; max-width: none; margin-top: 0.75rem; }
      .titleblock { grid-template-columns: minmax(0, 1fr); }
    }
  </style>
</head>
<body>
<header class="masthead">
  <span class="brand">
    <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M3 9h9M3 23h9M20 9h9M20 23h9" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 9l4 7M12 23l4-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M2 16h8M22 16h8" fill="none" stroke="var(--water)" stroke-width="1.5" stroke-dasharray="2 3"/>
    </svg>
    <span class="brand__word">sluice</span>
  </span>
</header>

<main class="sheet">
  <div class="sheet__drawing">
    <!-- the request arrives in the inlet and is turned away at the gate -->
    <svg class="drawing" viewBox="0 0 960 200" aria-hidden="true">
      <defs>
        <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" class="hatch-line"/>
        </pattern>
      </defs>
      <g class="inlet">
        <path class="bank ink" pathLength="1" d="M0 100H540"/>
        <path class="bed" d="M0 100H540"/>
        <path class="water" d="M0 100H586"/>
        <path class="stream" d="M8 88H580M8 100H580M8 112H580"/>
        <text x="8" y="58">request</text>
      </g>
      <g class="gate">
        <rect class="wall ink" pathLength="1" x="540" y="10" width="120" height="64"/>
        <rect class="wall ink" pathLength="1" x="540" y="126" width="120" height="64"/>
        <line class="leaf" x1="600" y1="74" x2="588" y2="100"/>
        <line class="leaf" x1="600" y1="126" x2="588" y2="100"/>
        <circle class="hinge" cx="600" cy="74" r="3.5"/>
        <circle class="hinge" cx="600" cy="126" r="3.5"/>
        <path class="leader" d="M594 88L560 40H532"/>
        <text class="fault" x="526" y="44" text-anchor="end">gate shut</text>
      </g>
      <g class="outlet">
        <path class="dry" d="M660 74H952M660 126H952"/>
        <text x="680" y="58">no entry</text>
        <text x="680" y="152">the access list excludes this address</text>
      </g>
    </svg>

    <div class="notice">
      <p class="status">403 Forbidden</p>
      <h1>Access forbidden from this address</h1>
      {{#host}}<p class="lede"><span class="mono">{{host}}</span> is not reachable from your address.</p>{{/host}}
      {{^host}}<p class="lede">Your address is not on the access list of this route.</p>{{/host}}
      <p class="hint">The server or the route's allowed-cidrs excludes the client address.</p>
    </div>
  </div>

  <div class="sheet__title">
    <dl class="titleblock">
      <div class="titleblock__status"><dt>Status</dt><dd class="mono">403</dd></div>
      <div><dt>Host</dt><dd class="mono" data-testid="host">{{#host}}{{host}}{{/host}}{{^host}}(none){{/host}}</dd></div>
      <div><dt>Request</dt><dd class="mono" data-testid="request">{{method}} {{path}}</dd></div>
    </dl>
  </div>
</main>
</body>
</html>
