<header class="masthead">
  <a class="brand" href="/console">
    <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
      <path d="M3 9h9M3 23h9M20 9h9M20 23h9" fill="none" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 9l4 7M12 23l4-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M2 16h8M22 16h8" fill="none" stroke="var(--water)" stroke-width="1.5" stroke-dasharray="2 3"/>
    </svg>
    <span class="brand__word">sluice</span>
    <span class="brand__sub">console</span>
  </a>
  <div class="masthead__end">
    <nav class="masthead__nav" aria-label="Diagnostics">
      <a href="/console/health">Health</a>
      <a href="/console/info">Info</a>
      <a href="/console/metrics">Metrics</a>
    </nav>
    <form class="session" method="post" action="/logout">
      {{#_csrf}}<input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">{{/_csrf}}
      <span class="session__user"><span class="visually-hidden">Signed in as </span><span data-testid="signed-in-user">{{user}}</span></span>
      <button class="session__signout" type="submit">Sign out</button>
    </form>
  </div>
</header>
