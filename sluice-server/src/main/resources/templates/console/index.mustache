<!DOCTYPE html>
<html lang="en" data-link="live">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <!--
    noSwap keeps a failed poll (4xx / 5xx) from replacing the live regions with an error
    document; console.js flags the stale view instead. A poll that hangs past 5s is
    abandoned so the next one can start.
  -->
  <meta name="htmx-config" content='{"noSwap": [204, 304, "4xx", "5xx"], "defaultTimeout": 5000}'>
  <title>Sluice console</title>
  <link rel="icon" type="image/svg+xml" href="{{#src}}/console/img/logo.svg{{/src}}">
  <link rel="preload" href="{{#src}}/console/fonts/overpass.woff2{{/src}}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{#src}}/console/css/console.css{{/src}}">
  <!-- source: https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js -->
  <script src="{{#src}}/console/js/vendor/htmx.min.js{{/src}}" defer></script>
  <script src="{{#src}}/console/js/console.min.js{{/src}}" defer></script>
</head>
<body>
<div hidden data-poller hx-get="/console/live" hx-trigger="every 2s"></div>

{{>console/masthead}}

<section class="sheet" aria-label="Traffic through this node">
  <div id="flow" class="sheet__drawing">{{>console/flow}}</div>
  <div id="status" class="sheet__title">{{>console/status}}</div>
</section>

<div class="layout">
  <main class="layout__main">
    <section class="panel" aria-labelledby="clients-heading">
      <h2 id="clients-heading" class="rule-heading">Clients</h2>
      <div id="clients">{{>console/clients}}</div>
    </section>
    <section class="panel" aria-labelledby="routes-heading">
      <h2 id="routes-heading" class="rule-heading">Routes</h2>
      <div id="routes">{{>console/routes}}</div>
    </section>
  </main>

  <aside class="layout__side">
    <section class="panel" aria-labelledby="lookup-heading">
      <h2 id="lookup-heading" class="rule-heading">Find a route</h2>
      <p class="hint">Shows which client a request is sent to for a given Host header.</p>
      <search class="lookup">
        <label for="lookup-host">Host</label>
        <input id="lookup-host" name="host" type="search" autocomplete="off" spellcheck="false"
               placeholder="app.example.com"
               hx-get="/console/lookup"
               hx-trigger="input changed delay:250ms, search"
               hx-target="#lookup-result">
      </search>
      <div id="lookup-result" aria-live="polite"></div>
    </section>

    <section class="panel" aria-labelledby="cluster-heading">
      <h2 id="cluster-heading" class="rule-heading">Cluster</h2>
      <div id="cluster">{{>console/cluster}}</div>
    </section>

    <section class="panel" aria-labelledby="certificates-heading">
      <h2 id="certificates-heading" class="rule-heading">Client certificate</h2>
      {{#clientCertificate}}
      <p class="hint">Client certificates for the mTLS control plane are signed by <span class="mono">{{caSubject}}</span>.</p>
      <a class="cert-link" href="/console/certificates">Issue a certificate</a>
      {{/clientCertificate}}
      {{^clientCertificate}}
      <p class="empty">No CA configured. Point <code>sluice.ca-bundle</code> at an SSL bundle holding the issuer key pair to enable issuance.</p>
      {{/clientCertificate}}
    </section>

    <section class="panel" aria-labelledby="settings-heading">
      <h2 id="settings-heading" class="rule-heading">Settings</h2>
      <dl class="settings">
        {{#settings}}
        <div><dt>{{name}}</dt><dd>{{value}}</dd></div>
        {{/settings}}
      </dl>
    </section>
  </aside>
</div>
</body>
</html>
