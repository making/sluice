<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{page.title}} | Sluice console</title>
  <link rel="icon" type="image/svg+xml" href="{{#src}}/console/img/logo.svg{{/src}}">
  <link rel="stylesheet" href="{{#src}}/console/css/console.css{{/src}}">
</head>
<body class="login">
<div class="login__column">
  <header class="login__brand">
    <span class="brand">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M3 9h9M3 23h9M20 9h9M20 23h9" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 9l4 7M12 23l4-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M2 16h8M22 16h8" fill="none" stroke="var(--water)" stroke-width="1.5" stroke-dasharray="2 3"/>
      </svg>
      <span class="brand__word">sluice</span>
      <span class="brand__sub">console</span>
    </span>
  </header>

  <main class="login__sheet">
    <div class="login__body">
      <h1 class="rule-heading">{{page.title}}</h1>
      <p class="mono login__note">{{page.status}} {{page.reason}}</p>
      {{#page.detail}}<p class="login__note">{{page.detail}}</p>{{/page.detail}}
      {{#page.stale}}<a class="login__submit" href="/login">Sign in again</a>{{/page.stale}}
      {{^page.stale}}<a class="login__submit" href="/console">Back to the console</a>{{/page.stale}}
    </div>
  </main>
</div>
</body>
</html>
