<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Sign in to Sluice console</title>
  <link rel="icon" type="image/svg+xml" href="{{#src}}/console/img/logo.svg{{/src}}">
  <link rel="preload" href="{{#src}}/console/fonts/overpass.woff2{{/src}}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{#src}}/console/css/console.css{{/src}}">
</head>
<body class="login">
<div class="login__column">
  <header class="login__brand">
    <span class="brand">
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M3 9h9M3 23h9M20 9h9M20 23h9" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <path d="M12 9l4 7M12 23l4-7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M2 16h8M22 16h8" fill="none" stroke="var(--water)" stroke-width="1.5" stroke-dasharray="2 3"/>
      </svg>
      <span class="brand__word">sluice</span>
      <span class="brand__sub">console</span>
    </span>
  </header>

  <main class="login__sheet">
    <!-- the lock from the console drawing, gates shut and water held upstream -->
    <svg class="login__drawing" viewBox="0 0 440 132" aria-hidden="true">
      <defs>
        <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="7" class="hatch-line"/>
        </pattern>
      </defs>
      <path class="bank bank--conduit ink" pathLength="1" d="M 0 66 L 440 66"/>
      <path class="bed bed--conduit" d="M 0 66 L 440 66"/>
      <path class="login__held" d="M 0 40 L 240 40 L 228 66 L 240 92 L 0 92 Z"/>
      <rect class="wall ink" pathLength="1" x="200" y="4" width="80" height="36"/>
      <rect class="wall ink" pathLength="1" x="200" y="92" width="80" height="36"/>
      <line class="leaf" x1="240" y1="40" x2="228" y2="66"/>
      <line class="leaf" x1="240" y1="92" x2="228" y2="66"/>
      <circle class="hinge" cx="240" cy="40" r="3.5"/>
      <circle class="hinge" cx="240" cy="92" r="3.5"/>
    </svg>

    <div class="login__body">
      <h1 class="rule-heading">Sign in</h1>
      {{#logout}}<p class="login__note">You have signed out.</p>{{/logout}}
      {{#error}}<p class="login__note login__note--fault" role="alert">{{error}}</p>{{/error}}
      {{#simple}}
      <form class="login__form" method="post" action="/login">
        {{#_csrf}}<input type="hidden" name="{{_csrf.parameterName}}" value="{{_csrf.token}}">{{/_csrf}}
        <div class="login__field">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required autofocus autocomplete="username"
                 autocapitalize="none" spellcheck="false">
        </div>
        <div class="login__field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password">
        </div>
        <button class="login__submit" type="submit">Sign in</button>
      </form>
      {{/simple}}
      {{^simple}}
      <nav class="login__providers" aria-label="Sign-in providers">
        {{#oidcClients}}<a class="login__submit" href="/oauth2/authorization/{{provider}}">Sign in with {{name}}</a>{{/oidcClients}}
      </nav>
      {{/simple}}
    </div>
  </main>
</div>
</body>
</html>
