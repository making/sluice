<!DOCTYPE html>
<html lang="en" data-link="live">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <!--
    noSwap keeps a failed poll (4xx / 5xx) from replacing the live region with an error
    document; console.js flags the stale view instead. A poll that hangs past 5s is
    abandoned so the next one can start.
  -->
  <meta name="htmx-config" content='{"noSwap": [204, 304, "4xx", "5xx"], "defaultTimeout": 5000}'>
  <title>Health | Sluice console</title>
  <link rel="icon" type="image/svg+xml" href="{{#src}}/console/img/logo.svg{{/src}}">
  <link rel="stylesheet" href="{{#src}}/console/css/console.css{{/src}}">
  <!-- source: https://unpkg.com/htmx.org@4.0.0/dist/htmx.min.js -->
  <script src="{{#src}}/console/js/vendor/htmx.min.js{{/src}}" defer></script>
  <script src="{{#src}}/console/js/console.min.js{{/src}}" defer></script>
</head>
<body>
<div hidden data-poller hx-get="/console/health/live" hx-trigger="every 5s"></div>

{{>console/masthead}}

<main class="report">
  <section class="panel" aria-labelledby="health-heading">
    <h1 id="health-heading" class="rule-heading">Health</h1>
    <div id="health-report">{{>console/health-report}}</div>
  </section>
</main>
</body>
</html>
