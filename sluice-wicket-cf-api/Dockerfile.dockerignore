# the context is the repository root; the build needs the proto, the crate, its build script
# dependency and sluice-wicket-site with the WIT it builds on only
*
!sluice-proto/src/main/proto
!sluice-build-info/Cargo.toml
!sluice-build-info/src
!sluice-wicket-oidc/Cargo.toml
!sluice-wicket-oidc/src
!sluice-wicket-server/Cargo.toml
!sluice-wicket-server/src
!sluice-wicket-console/Cargo.toml
!sluice-wicket-console/src
!sluice-wicket-registry/Cargo.toml
!sluice-wicket-registry/src
!sluice-wicket-cf-api/Cargo.toml
!sluice-wicket-cf-api/Cargo.lock
!sluice-wicket-cf-api/build.rs
!sluice-wicket-cf-api/src
!sluice-wicket-runtime-wasi/wit
!sluice-wicket-site/.cargo
!sluice-wicket-site/Cargo.toml
!sluice-wicket-site/Cargo.lock
!sluice-wicket-site/rust-toolchain.toml
!sluice-wicket-site/src
