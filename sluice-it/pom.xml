<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>am.ik.sluice</groupId>
		<artifactId>sluice-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>sluice-it</artifactId>
	<properties>
		<java.version>25</java.version>
		<!-- the test JVMs running at once: the classes mostly wait on timeouts, so more
			 than the 4 vCPUs of a CI runner -->
		<sluice.it.forks>6</sluice.it.forks>
		<!-- the build of sluice-flume the live access log tests run as a child process -->
		<sluice.flume.dir>${project.basedir}/../sluice-flume</sluice.flume.dir>
		<skipTests>false</skipTests>
	</properties>
	<dependencies>
		<dependency>
			<groupId>am.ik.sluice</groupId>
			<artifactId>sluice-server</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>am.ik.sluice</groupId>
			<artifactId>sluice-client</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-grpc-server</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-grpc-client</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.lettuce</groupId>
			<artifactId>lettuce-core</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>validate</goal>
						</goals>
						<phase>validate</phase>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>am.ik.maven</groupId>
				<artifactId>nullability-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Builds sluice-flume (Rust, debug) for the live access log tests; a
					 missing Rust toolchain fails the build rather than skipping them. -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>build-sluice-flume</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<skip>${skipTests}</skip>
							<executable>cargo</executable>
							<arguments>
								<argument>build</argument>
								<argument>--manifest-path</argument>
								<argument>${sluice.flume.dir}/Cargo.toml</argument>
								<argument>--target-dir</argument>
								<argument>${sluice.flume.dir}/target</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- The classes run in parallel JVMs, a class at a time in each, so they share no
					 JVM state; TestPorts claims ports across JVMs. The JVMs compile
					 with C1 only: C2 in six JVMs at once keeps the CPUs busy (on 1.8 CPUs the
					 class times summed to 869s with C2, 720s with C1 only). -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<forkCount>${sluice.it.forks}</forkCount>
					<reuseForks>true</reuseForks>
					<argLine>-XX:TieredStopAtLevel=1</argLine>
					<systemPropertyVariables>
						<sluice.flume.binary>${sluice.flume.dir}/target/debug/sluice-flume</sluice.flume.binary>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
